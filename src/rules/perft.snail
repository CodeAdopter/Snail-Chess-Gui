use rules/moves
use rules/make

fn perft(board: *Board, depth: int) -> u64
    if depth == 0: return 1
    var list: MoveList = undefined
    list.fill(board)
    if depth == 1: return list.count as u64
    var nodes: u64 = 0
    for i in 0..list.count
        var child = *board
        child.play(list.items[i])
        nodes += perft(&child, depth - 1)
    return nodes
