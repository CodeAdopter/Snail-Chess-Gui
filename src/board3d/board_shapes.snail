use src/chess/primitives
use src/board3d/piece_shapes
use src/board3d/scene_style

const BoardFrame: f32 = 0.62
const BoardDepth: f32 = 0.32

const Metre: f32 = 16.4

const FeltThick: f32 = 0.02

fn add_felt(m: *Mesh)
    let r: f32 = 0.24
    let e: f32 = 0.006
    let profile = [Vec2(0.0, 0.0), Vec2(r - e, 0.0), Vec2(r - e * 0.3, e * 0.3), Vec2(r, e), Vec2(r, FeltThick - e), Vec2(r - e * 0.3, FeltThick - e * 0.3), Vec2(r - e, FeltThick), Vec2(0.0, FeltThick)]
    add_lathe(m, profile[0..profile.len], 48)

fn foot_scale(kind: int) -> f32
    if kind == Knight as int: return KnightFoot
    if kind == Bishop as int: return BishopFoot
    if kind == Rook as int: return RookFoot
    if kind == Queen as int: return QueenFoot
    if kind == King as int: return KingFoot
    return 1.0

fn square_centre(sq: Square) -> Vec3
    return Vec3(sq.file as f32 - 3.5, 0.0, 3.5 - sq.rank as f32)

fn square_under(x: f32, z: f32) -> Square
    let file = floor(x + 4.0) as int
    let rank = floor(4.0 - z) as int
    if file < 0 or file > 7 or rank < 0 or rank > 7: return Square.none
    return Square(file, rank)

fn foot_width(kind: Kind) -> f32
    if kind == Pawn: return 0.27
    if kind == Queen: return 0.34
    if kind == King: return 0.35
    return 0.3

fn man_seed(piece: Piece, nth: int) -> f32
    let mix = (piece.kind() as f32 * 0.137 + piece.side() as f32 * 0.531 + nth as f32 * 0.173) * 3.7
    return mix - floor(mix)

fn piece_height(kind: Kind) -> f32
    if kind == Pawn: return 0.815
    if kind == Knight: return 0.978
    if kind == Bishop: return 1.141
    if kind == Rook: return 0.897
    if kind == Queen: return 1.3
    if kind == King: return 1.64
    return 1.0

fn add_board_field(m: *Mesh)
    add_plane(m, 8.0, 8.0, 1, 1)

fn board_frame_profile(o: *PieceOutline, style: BoardStyle)
    o.start()
    let deep = board_depth(style)
    let chamfer = 0.02
    o.at(0.0, 0.0)
    if style == WalnutBoard or style == BurlBoard
        let top = 0.02
        let soft = 0.06
        o.at(0.025, top)
        o.corner()
        o.arc(Vec2(BoardFrame - soft, top - soft), soft, 90.0, 0.0, 12)
    else
        let soft = style == MarbleBoard ? 0.1 : style == VinylBoard ? 0.005 : 0.012
        o.arc(Vec2(BoardFrame - soft, -soft), soft, 90.0, 0.0, style == MarbleBoard ? 12 : 4, true)
    if style == VinylBoard
        o.at(BoardFrame, -deep)
        o.corner()
        o.at(0.0, -deep)
        return
    o.at(BoardFrame, chamfer - deep)
    o.corner()
    o.at(BoardFrame - chamfer, -deep)
    o.corner()
    o.at(0.0, -deep)

fn add_board_frame(m: *Mesh, style: BoardStyle)
    var o: PieceOutline
    board_frame_profile(&o, style)
    let profile = o.outline()
    let n = profile.len as int
    for side in 0..4
        let turn = Quat.axis_angle(Vec3.up(), side as f32 * Pi * 0.5)
        let shift = side as f32 * 13.0
        let first = m.vertex_count as u32
        for i in 0..n
            let before = profile[max(i - 1, 0)]
            let after = profile[min(i + 1, n - 1)]
            let along = (after - before).normalized
            let normal = turn * Vec3(-along.y, along.x, 0.0)
            let reach = 4.0 + profile[i].x
            m.vertex(turn * Vec3(reach, profile[i].y, -reach), normal, Vec2(shift - reach, profile[i].x))
            m.vertex(turn * Vec3(reach, profile[i].y, reach), normal, Vec2(shift + reach, profile[i].x))
        for i in 0..n - 1
            let a = first + i as u32 * 2
            m.quad(a, a + 1, a + 3, a + 2)

fn add_board_floor(m: *Mesh, deep: f32)
    var plate: Mesh
    plate.init(8, 8)
    add_plane(&plate, 8.0, 8.0, 1, 1)
    m.append(&plate, Mat4.trs(Vec3(0.0, -deep, 0.0), Quat.axis_angle(Vec3(1.0, 0.0, 0.0), Pi), Vec3.splat(1.0)))
    plate.free_all()
