use src/board3d/mars_shapes
use src/board3d/room_look

struct MarsScene
    built: bool
    building: int
    builder: u64
    uploaded: int
    staged: bool
    build: MarsBuild
    shapes: [MarsParts]GpuMesh
    made: [MarsParts]bool
    parts: [MarsParts]int
    rock_shape: GpuMesh
    rock: int
    materials: [MarsParts]int
    rock_material: int
    lens: SceneLens

    fn parts_ready() -> bool
        if built: return true
        if building == 0
            building = 1
            builder = spawn(mars_builder, self)
        return atomic_load(&building) >= 2

    fn build_parts()
        build.init()
        build.build()
        build.scale_all()

    fn carve(gpu: *Gpu, ns: i64 = 0) -> bool
        if built: return true
        if building == 0: build_parts()
        if building == 1 or building == 2: join(builder)
        building = 3
        let began = now_ns()
        while uploaded < MarsParts
            if ns > 0 and now_ns() - began > ns: return false
            let k = uploaded
            made[k] = build.parts[k].vertex_count > 0
            if made[k]: shapes[k] = gpu.upload_mesh(&build.parts[k])
            uploaded += 1
        built = true
        building = 0
        uploaded = 0
        build.free_parts()
        var m: Mesh
        m.init(256, 1024)
        add_sphere(&m, 1.0, 7, 5)
        rock_shape = gpu.upload_mesh(&m)
        m.free_all()
        return true

    fn stage(r: *Renderer)
        if staged: return
        staged = true
        let casting = [0, 2, 0, 0, 6, 6, 6, 4, 0, 0]
        for k in 0..MarsParts
            if not made[k]: continue
            parts[k] = r.add_mesh(&shapes[k])
            r.casts[parts[k]] = casting[k] as u8
        rock = r.add_mesh(&rock_shape)
        r.casts[rock] = 6
        materials[MarsGroundPart] = mars_material(r, shader("shaders/mars3d.hlsl", fragment: "mars_ground_ps"), CullBack)
        materials[MarsSlabPart] = mars_material(r, shader("shaders/mars3d.hlsl", fragment: "mars_rock_ps"), CullBack)
        materials[MarsRidgePart] = mars_material(r, shader("shaders/mars3d.hlsl", fragment: "mars_ridge_ps"), CullNone)
        materials[MarsSkyPart] = mars_material(r, shader("shaders/mars3d.hlsl", fragment: "mars_sky_ps"), CullNone)
        materials[MarsMetalPart] = mars_material(r, shader("shaders/mars3d.hlsl", fragment: "mars_metal_ps"), CullBack)
        materials[MarsFoilPart] = mars_material(r, shader("shaders/mars3d.hlsl", fragment: "mars_foil_ps"), CullBack)
        materials[MarsPanelPart] = mars_material(r, shader("shaders/mars3d.hlsl", fragment: "mars_panel_ps"), CullBack)
        materials[MarsDomePart] = mars_material(r, shader("shaders/mars3d.hlsl", fragment: "mars_dome_ps"), CullBack)
        materials[MarsGlowPart] = mars_material(r, shader("shaders/mars3d.hlsl", fragment: "mars_glow_ps"), CullBack)
        rock_material = mars_material(r, shader("shaders/mars3d.hlsl", fragment: "mars_rock_ps"), CullBack)
        var desc = MaterialDesc.three(shader("shaders/mars3d.hlsl", fragment: "mars_devil_ps"))
        desc.vertex = shader("shaders/mars3d.hlsl", vertex: "wood_vs")
        desc.cull = CullNone
        desc.blend = Glaze
        desc.depth = TestOnly
        materials[MarsDevilPart] = r.add_material_desc(&desc)
        r.materials[materials[MarsDevilPart]].order = 150 as u8
        r.materials[materials[MarsSkyPart]].no_fog = true
        r.materials[materials[MarsSlabPart]].values[0] = Vec4(1.0, 0.0, 0.0, 0.0)
        r.materials[rock_material].values[0] = Vec4(0.0, 0.0, 0.0, 0.0)
        let rover = mars_rover_at()
        r.materials[materials[MarsGroundPart]].values[0] = Vec4(rover.x, rover.z, 0.75, 0.0)
        lens.init(r)

    fn unstage()
        staged = false

    fn lens_on(r: *Renderer, on: bool)
        if staged: lens.show(r, on)

    fn lights(r: *Renderer, shadow: int)
        let sun = mars_sun_way()
        r.exposure = 0.75
        r.lighting.sun_direction = Vec4.of(sun * -1.0, 0.0)
        r.lighting.sun_color = Vec4(2.7, 2.4, 2.1, 0.0)
        r.lighting.sky_color = Vec4(0.36, 0.24, 0.17, 0.0)
        r.lighting.ground_color = Vec4(0.24, 0.12, 0.06, 0.0)
        r.lighting.sun_through = Vec4(6.0, 1.0, 0.0, 0.0)
        let origin = Vec3(0.0, 0.0, 0.0)
        shadow_from(&r.shadows[0], sun * 14.0, origin, 8.5, 8.5, 30.0, shadow, 2.0, 0.012, true)
        shadow_from(&r.shadows[1], sun * (16.0 * Metre), Vec3(2.5, 0.0, -2.0) * Metre, 8.0 * Metre, 8.0 * Metre, 34.0 * Metre, 2048, 2.0, 0.12, false)
        shadow_from(&r.shadows[2], sun * (60.0 * Metre), origin, 40.0 * Metre, 40.0 * Metre, 130.0 * Metre, 2048, 1.5, 0.5, false)
        let m2 = Metre * Metre
        let mast = mars_mast_light() * Metre
        set_lamp(r, 0, mast, 16.0 * Metre, Vec3(0.75, 0.86, 1.0) * (9.0 * m2), 0, (Vec3(0.0, -0.2, 0.0) - mars_mast_light()).normalized, 0.75)
        r.lighting.lamp_room = Vec4(1.0, 0.0, 0.0, 0.2 * Metre)
        r.fog = SceneFog(Exp2Fog, Color(0.5, 0.33, 0.22, 1.0), 0.0, 0.0, 0.00009)
        r.sky = Color(0.5, 0.33, 0.22, 1.0)

    fn draw(r: *Renderer, camera: *Camera, at: Vec3, t: f32, height: f32, shadow: int, lift: f32, near_only: bool = false, unseen: int = -1)
        lights(r, shadow)
        lens.focus(camera, at, height, t)
        r.materials[materials[MarsDevilPart]].values[0] = Vec4(t, 0.0, 0.0, 0.0)
        r.materials[materials[MarsDomePart]].values[0] = Vec4(t, 0.0, 0.0, 0.0)
        let white = Color.hex(0xFFFFFF)
        let raise = Mat4.translation(Vec3(0.0, lift, 0.0))
        for k in 0..MarsParts
            if not made[k] or near_only and k != MarsSlabPart: continue
            let hidden = k == MarsSlabPart and not near_only and unseen >= 0
            r.draw_with(hidden ? unseen : materials[k], parts[k], raise, white)
        if near_only: return
        for i in 0..build.rock_count: r.draw_with(rock_material, rock, raise * build.rocks[i], build.rock_tints[i])

    fn release(gpu: *Gpu)
        if building == 1 or building == 2: join(builder)
        if building == 3
            for k in 0..uploaded
                if made[k]: gpu.release_mesh(&shapes[k])
                made[k] = false
            uploaded = 0
        if building != 0
            building = 0
            build.free_parts()
        if not built: return
        for k in 0..MarsParts
            if made[k]: gpu.release_mesh(&shapes[k])
            made[k] = false
        gpu.release_mesh(&rock_shape)
        free(build.rocks)
        free(build.rock_tints)
        built = false
        staged = false

fn mars_material(r: *Renderer, fragment: ShaderCode, cull: Cull) -> int
    var desc = MaterialDesc.three(fragment)
    desc.vertex = shader("shaders/mars3d.hlsl", vertex: "wood_vs")
    desc.cull = cull
    return r.add_material_desc(&desc)

fn mars_builder(r: *MarsScene)
    r.build_parts()
    atomic_store(&r.building, 2)
