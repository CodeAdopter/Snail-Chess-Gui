const FlingLift: f32 = 0.25

struct ArcArrow
    from: Square
    to: Square
    color: Color
    width: f32

struct BoardShow
    board: *Board
    last: Move
    selected: Square
    lifted: bool
    pointer: Vec2
    hover: Square
    targets: u64
    captures: u64
    target: Color
    check: Square
    slides: *PieceSlides
    landed: Move
    arrows: [SceneArrows]ArcArrow
    arrow_count: int
    flat_arrows: bool
    flipped: bool
    accent: Color
    accent_ink: Color
    page: Color
    fonts: *GuiFonts
    free: *FreeBoard
    fx: SceneFx

    fn arrow(from: Square, to: Square, color: Color, width: f32)
        if arrow_count >= SceneArrows: return
        arrows[arrow_count] = ArcArrow(from, to, color, width)
        arrow_count += 1

struct SceneQuality
    samples: int = 4
    scale: f32 = 1.0
    shadow: int = 2048
    aniso: f32 = 8.0
    fps: int = 0

