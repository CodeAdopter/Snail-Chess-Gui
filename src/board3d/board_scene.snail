const WholePass = 0
const AsidePass = 1
const SharpPass = 2

const SceneTickNs: i64 = 33333333
const MotionHoldNs: i64 = 180000000
const MotionTargets = 3
const ParkLayerNs: i64 = 100000000

const StillFrameNs: i64 = 6000000
const UploadFrameNs: i64 = 4000000

