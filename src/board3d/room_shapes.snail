use src/board3d/board_shapes
use src/board3d/scene_lens

const RoomFloor: f32 = -0.7695
const RoomWest: f32 = -2.4
const RoomEast: f32 = 2.4
const RoomNorth: f32 = -2.7
const RoomSouth: f32 = 2.5
const RoomHigh: f32 = 2.75

const WindowFrom: f32 = -0.95
const WindowTo: f32 = 0.45
const WindowLow: f32 = 0.82
const WindowHigh: f32 = 2.25

const HearthHigh: f32 = 0.3

const FloorPart = 0
const WallPart = 1
const CeilingPart = 2
const BrickPart = 3
const SlatePart = 4
const WalnutPart = 5
const TablePart = 6
const RugPart = 7
const ChairPart = 8
const ChairFeetPart = 9
const BrassPart = 10
const IronPart = 11
const ShadePart = 12
const GlassPart = 13
const CurtainPart = 14
const CanvasPart = 15
const WaxPart = 16
const CoalPart = 17
const RoomParts = 18

const RoomBooks = 4096
const RoomLogs = 4
const RoomFlames = 16
const RoomHalos = 4

fn fire_at() -> Vec3
    return Vec3(0.0, RoomFloor + HearthHigh + 0.12, -2.48)

fn lamp_at() -> Vec3
    return Vec3(-0.82, RoomFloor + 1.42, 0.78)

fn pendant_at() -> Vec3
    return Vec3(0.0, 1.6, 0.0)

fn moon_way() -> Vec3
    return Vec3(1.0, 0.55, -0.35).normalized

fn chair_place(k: int) -> (Vec3, f32)
    let side: f32 = k == 0 ? -1.0 : 1.0
    return Vec3(side * 1.55, RoomFloor, -1.45), side * -1.15

struct ShelfRun
    origin: Vec3
    along: Vec3
    out: Vec3
    length: f32
    high: f32
    deep: f32
    shelves: int

    fn at(u: f32, v: f32, w: f32) -> Vec3
        return origin + along * u + Vec3(0.0, v, 0.0) + out * w

struct RoomFlame
    at: Vec3
    size: Vec2
    seed: f32

struct RoomBuild
    parts: [RoomParts]Mesh
    part: Mesh
    books: *Mat4
    book_tints: *Color
    book_count: int
    logs: [RoomLogs]Mat4
    log_count: int
    flames: [RoomFlames]RoomFlame
    flame_count: int
    halos: [RoomHalos]RoomFlame
    halo_tints: [RoomHalos]Color
    halo_count: int
    rng: Mulberry32

    fn init()
        for k in 0..RoomParts: parts[k].init(4096, 16384)
        part.init(4096, 16384)
        books = alloc[Mat4](RoomBooks)
        book_tints = alloc[Color](RoomBooks)
        rng = Mulberry32(0x5EA7ED)

    fn free_parts()
        for k in 0..RoomParts: parts[k].free_all()
        part.free_all()

    fn free_all()
        free_parts()
        free(books)
        free(book_tints)

    fn random(lo: f32, hi: f32) -> f32
        return lo + (hi - lo) * rng.next() as f32

    fn build()
        room_box()
        fireplace()
        fire()
        table()
        rug()
        chairs()
        lamp()
        pendant()
        window()
        bookcase(ShelfRun(Vec3(-2.02, RoomFloor, RoomNorth), Vec3(1.0, 0.0, 0.0), Vec3(0.0, 0.0, 1.0), 1.07, 2.3, 0.38, 6))
        bookcase(ShelfRun(Vec3(0.95, RoomFloor, RoomNorth), Vec3(1.0, 0.0, 0.0), Vec3(0.0, 0.0, 1.0), 1.45, 2.3, 0.38, 6))
        bookcase(ShelfRun(Vec3(RoomWest, RoomFloor, 2.12), Vec3(0.0, 0.0, -1.0), Vec3(1.0, 0.0, 0.0), 4.44, 2.3, 0.38, 6))
        bookcase(ShelfRun(Vec3(0.62, RoomFloor, RoomSouth), Vec3(-1.0, 0.0, 0.0), Vec3(0.0, 0.0, -1.0), 2.64, 2.3, 0.38, 6))
        door()

    fn scale_all()
        let s = Mat4.trs(Vec3(0.0, 0.0, 0.0), Quat.identity(), Vec3.splat(Metre))
        for k in 0..RoomParts
            if k != ChairPart and k != ChairFeetPart: parts[k].transform(s)
        parts[ChairPart].transform(s)
        parts[ChairFeetPart].transform(s)

    fn block(k: int, low: Vec3, high: Vec3, grain: Vec3, seed: f32)
        part.clear()
        part.set_color(Color(grain.x, grain.y, grain.z, seed - floor(seed)))
        add_box(&part, high - low)
        parts[k].append(&part, Mat4.translation((low + high) * 0.5))

    fn turned(k: int, profile: []Vec2, at: Vec3, seed: f32)
        part.clear()
        part.set_color(Color(0.0, 1.0, 0.0, seed - floor(seed)))
        add_lathe(&part, profile, 32)
        parts[k].append(&part, Mat4.translation(at))

    fn soft_box(k: int, at: Vec3, half: Vec3, round: f32, turn: Quat = Quat.identity())
        part.clear()
        add_rounded_box(&part, half, round, 3)
        parts[k].append(&part, Mat4.trs(at, turn, Vec3.splat(1.0)))

    fn lump(k: int, at: Vec3, radii: Vec3, segments: int)
        part.clear()
        add_sphere(&part, 1.0, segments, max(segments / 2, 4))
        parts[k].append(&part, Mat4.trs(at, Quat.identity(), radii))

    fn room_box()
        let up = Vec3(0.0, 1.0, 0.0)
        let top = RoomFloor + RoomHigh
        part.clear()
        part.set_color(Color(1.0, 1.0, 1.0, 1.0))
        add_plane(&part, RoomEast - RoomWest, RoomSouth - RoomNorth, 1, 1)
        parts[FloorPart].append(&part, Mat4.translation(Vec3((RoomWest + RoomEast) * 0.5, RoomFloor, (RoomNorth + RoomSouth) * 0.5)))
        let k = WallPart
        block(k, Vec3(RoomWest - 0.25, RoomFloor, RoomNorth - 0.25), Vec3(RoomEast + 0.25, top, RoomNorth), up, 0.0)
        block(k, Vec3(RoomWest - 0.25, RoomFloor, RoomSouth), Vec3(RoomEast + 0.25, top, RoomSouth + 0.25), up, 0.0)
        block(k, Vec3(RoomWest - 0.25, RoomFloor, RoomNorth), Vec3(RoomWest, top, RoomSouth), up, 0.0)
        block(k, Vec3(RoomEast, RoomFloor, RoomNorth), Vec3(RoomEast + 0.25, top, WindowFrom), up, 0.0)
        block(k, Vec3(RoomEast, RoomFloor, WindowTo), Vec3(RoomEast + 0.25, top, RoomSouth), up, 0.0)
        block(k, Vec3(RoomEast, RoomFloor, WindowFrom), Vec3(RoomEast + 0.25, RoomFloor + WindowLow, WindowTo), up, 0.0)
        block(k, Vec3(RoomEast, RoomFloor + WindowHigh, WindowFrom), Vec3(RoomEast + 0.25, top, WindowTo), up, 0.0)
        block(CeilingPart, Vec3(RoomWest, top, RoomNorth), Vec3(RoomEast, top + 0.1, RoomSouth), up, 0.0)

    fn fireplace()
        let g = RoomFloor
        let f = RoomFloor + HearthHigh
        let top = RoomFloor + RoomHigh
        let x = Vec3(1.0, 0.0, 0.0)
        let y = Vec3(0.0, 1.0, 0.0)
        let z = Vec3(0.0, 0.0, 1.0)
        block(BrickPart, Vec3(-0.95, g, RoomNorth), Vec3(-0.45, top, -2.3), y, 0.0)
        block(BrickPart, Vec3(0.45, g, RoomNorth), Vec3(0.95, top, -2.3), y, 0.0)
        block(BrickPart, Vec3(-0.45, f + 0.78, RoomNorth), Vec3(0.45, top, -2.3), y, 0.0)
        block(BrickPart, Vec3(-0.45, g, RoomNorth), Vec3(0.45, f + 0.78, -2.64), y, 0.0)
        block(BrickPart, Vec3(-0.45, g, -2.64), Vec3(0.45, f + 0.03, -2.3), y, 0.0)
        block(SlatePart, Vec3(-1.05, g, -2.3), Vec3(1.05, f, -1.86), x, 0.0)
        block(SlatePart, Vec3(-1.08, f - 0.04, -2.3), Vec3(1.08, f + 0.01, -1.83), x, 0.0)
        for i in 0..2
            let side: f32 = i == 0 ? -1.0 : 1.0
            let a = Vec3(side * 0.58, f + 0.01, -2.3)
            let b = Vec3(side * 0.76, f + 1.1, -2.22)
            block(WalnutPart, lowest(a, b), highest(a, b), y, 0.33 + side * 0.2)
        block(WalnutPart, Vec3(-0.76, f + 0.95, -2.3), Vec3(0.76, f + 1.1, -2.22), x, 0.71)
        block(WalnutPart, Vec3(-0.8, f + 1.08, -2.3), Vec3(0.8, f + 1.1, -2.19), x, 0.37)
        block(WalnutPart, Vec3(-1.02, f + 1.1, -2.36), Vec3(1.02, f + 1.16, -2.04), x, 0.89)
        block(CanvasPart, Vec3(-0.4, f + 1.36, -2.3), Vec3(0.4, f + 1.88, -2.27), z, 0.0)
        block(BrassPart, Vec3(-0.46, f + 1.3, -2.3), Vec3(0.46, f + 1.36, -2.25), x, 0.0)
        block(BrassPart, Vec3(-0.46, f + 1.88, -2.3), Vec3(0.46, f + 1.94, -2.25), x, 0.0)
        block(BrassPart, Vec3(-0.46, f + 1.36, -2.3), Vec3(-0.4, f + 1.88, -2.25), y, 0.0)
        block(BrassPart, Vec3(0.4, f + 1.36, -2.3), Vec3(0.46, f + 1.88, -2.25), y, 0.0)
        let stick = [Vec2(0.0, 0.0), Vec2(0.05, 0.0), Vec2(0.052, 0.008), Vec2(0.045, 0.016), Vec2(0.02, 0.03), Vec2(0.014, 0.05), Vec2(0.012, 0.1), Vec2(0.018, 0.12), Vec2(0.013, 0.14), Vec2(0.012, 0.16), Vec2(0.022, 0.165), Vec2(0.022, 0.17), Vec2(0.0, 0.17)]
        let candle = [Vec2(0.0, 0.0), Vec2(0.011, 0.0), Vec2(0.011, 0.145), Vec2(0.009, 0.15), Vec2(0.0, 0.148)]
        for i in 0..2
            let side: f32 = i == 0 ? -1.0 : 1.0
            let at = Vec3(side * 0.8, f + 1.16, -2.18)
            turned(BrassPart, stick[0..stick.len], at, 0.0)
            turned(WaxPart, candle[0..candle.len], at + Vec3(0.0, 0.17, 0.0), 0.0)
            let wick = at + Vec3(0.0, 0.17 + 0.152, 0.0)
            add_flame(wick, Vec2(0.026, 0.06))
            add_halo(wick + Vec3(0.0, 0.025, 0.0), 0.16, Color(1.0, 0.75, 0.45, 1.0))
        block(IronPart, Vec3(-0.28, f + 0.03, -2.37), Vec3(0.28, f + 0.05, -2.35), x, 0.0)
        block(IronPart, Vec3(-0.28, f + 0.03, -2.6), Vec3(0.28, f + 0.05, -2.58), x, 0.0)
        for i in 0..7
            let sx = -0.24 + i as f32 * 0.08
            block(IronPart, Vec3(sx - 0.007, f + 0.045, -2.6), Vec3(sx + 0.007, f + 0.058, -2.35), z, 0.0)
        for i in 0..2
            let side: f32 = i == 0 ? -1.0 : 1.0
            block(IronPart, Vec3(side * 0.28 - 0.012, f + 0.03, -2.38), Vec3(side * 0.28 + 0.012, f + 0.17, -2.355), y, 0.0)
            part.clear()
            add_sphere(&part, 0.024, 20, 12)
            parts[BrassPart].append(&part, Mat4.translation(Vec3(side * 0.28, f + 0.19, -2.367)))

    fn fire()
        let f = RoomFloor + HearthHigh
        let along_x = Quat.axis_angle(Vec3(0.0, 0.0, 1.0), Pi * 0.5)
        add_log(Vec3(0.0, f + 0.115, -2.55), along_x, 0.06, 0.52)
        add_log(Vec3(0.02, f + 0.105, -2.42), Quat.axis_angle(Vec3(0.0, 1.0, 0.0), 0.14) * along_x, 0.05, 0.46)
        add_log(Vec3(-0.03, f + 0.2, -2.49), Quat.axis_angle(Vec3(0.0, 1.0, 0.0), -0.4) * Quat.axis_angle(Vec3(1.0, 0.0, 0.0), 0.12) * along_x, 0.045, 0.44)
        lump(CoalPart, Vec3(0.0, f + 0.045, -2.49), Vec3(0.25, 0.022, 0.12), 24)
        for i in 0..44
            let x = random(-0.22, 0.22)
            let z = random(-0.1, 0.1) * (1.0 - abs(x) * 1.6)
            let r = random(0.014, 0.034)
            lump(CoalPart, Vec3(x, f + 0.052 + random(0.0, 0.02), -2.49 + z), Vec3(r, r * random(0.55, 0.9), r * random(0.7, 1.1)), 10)
        for i in 0..11
            let x = -0.2 + i as f32 * 0.04 + random(-0.015, 0.015)
            let tall = random(0.22, 0.5) * (1.0 - abs(x) * 1.4)
            add_flame(Vec3(x, f + random(0.08, 0.14), -2.49 + random(-0.05, 0.05)), Vec2(random(0.13, 0.22), tall))
        add_halo(Vec3(0.0, f + 0.28, -2.3), 0.9, Color(0.8, 0.42, 0.18, 1.0))

    fn add_log(at: Vec3, turn: Quat, radius: f32, long: f32)
        if log_count >= RoomLogs: return
        logs[log_count] = Mat4.trs(at * Metre, turn, Vec3(radius, long, radius) * Metre)
        log_count += 1

    fn add_flame(root: Vec3, size: Vec2)
        if flame_count >= RoomFlames: return
        flames[flame_count] = RoomFlame(root * Metre, size * Metre, random(0.0, 1.0))
        flame_count += 1

    fn add_halo(at: Vec3, size: f32, tint: Color)
        if halo_count >= RoomHalos: return
        halos[halo_count] = RoomFlame(at * Metre, Vec2(size, size) * Metre, 0.0)
        halo_tints[halo_count] = tint
        halo_count += 1

    fn table()
        let top = -BoardDepth / Metre
        let x = Vec3(1.0, 0.0, 0.0)
        let z = Vec3(0.0, 0.0, 1.0)
        let k = TablePart
        block(k, Vec3(-0.52, top - 0.035, -0.36), Vec3(0.52, top, 0.36), x, 0.31)
        block(k, Vec3(-0.45, top - 0.12, -0.29), Vec3(0.45, top - 0.035, -0.27), x, 0.47)
        block(k, Vec3(-0.45, top - 0.12, 0.27), Vec3(0.45, top - 0.035, 0.29), x, 0.53)
        block(k, Vec3(-0.45, top - 0.12, -0.27), Vec3(-0.43, top - 0.035, 0.27), z, 0.61)
        block(k, Vec3(0.43, top - 0.12, -0.27), Vec3(0.45, top - 0.035, 0.27), z, 0.67)
        let h = top - 0.035 - RoomFloor
        let leg = [Vec2(0.0, 0.0), Vec2(0.03, 0.0), Vec2(0.034, 0.014), Vec2(0.027, 0.035), Vec2(0.023, 0.07), Vec2(0.027, 0.2), Vec2(0.035, 0.3), Vec2(0.039, 0.36), Vec2(0.035, 0.42), Vec2(0.026, 0.5), Vec2(0.031, 0.56), Vec2(0.036, 0.58), Vec2(0.036, h), Vec2(0.0, h)]
        for i in 0..4
            let lx: f32 = i % 2 == 0 ? -0.44 : 0.44
            let lz: f32 = i < 2 ? -0.28 : 0.28
            turned(k, leg[0..leg.len], Vec3(lx, RoomFloor, lz), 0.2 + i as f32 * 0.17)

    fn rug()
        block(RugPart, Vec3(-1.5, RoomFloor, -1.65), Vec3(1.5, RoomFloor + 0.012, 0.65), Vec3(1.0, 0.0, 0.0), 0.0)

    fn chairs()
        soft_box(ChairPart, Vec3(0.0, 0.26, 0.02), Vec3(0.37, 0.15, 0.36), 0.05)
        soft_box(ChairPart, Vec3(0.0, 0.45, 0.05), Vec3(0.28, 0.06, 0.31), 0.06)
        soft_box(ChairPart, Vec3(0.0, 0.7, -0.31), Vec3(0.37, 0.4, 0.08), 0.07, Quat.axis_angle(Vec3(1.0, 0.0, 0.0), -0.12))
        for i in 0..2
            let side: f32 = i == 0 ? -1.0 : 1.0
            soft_box(ChairPart, Vec3(side * 0.36, 0.42, 0.03), Vec3(0.075, 0.19, 0.37), 0.05)
            let back = Vec3(side * 0.38, 0.61, -0.3)
            let front = Vec3(side * 0.39, 0.61, 0.42)
            part.clear()
            add_capsule(&part, 0.085, (front - back).length, 24, 12)
            parts[ChairPart].append(&part, Mat4.trs((back + front) * 0.5, Quat.between(Vec3(0.0, 1.0, 0.0), (front - back).normalized), Vec3.splat(1.0)))
            soft_box(ChairPart, Vec3(side * 0.35, 0.92, -0.24), Vec3(0.06, 0.2, 0.15), 0.06)
        let foot = [Vec2(0.0, 0.0), Vec2(0.03, 0.0), Vec2(0.036, 0.03), Vec2(0.03, 0.06), Vec2(0.025, 0.11), Vec2(0.0, 0.11)]
        for i in 0..4
            let fx: f32 = i % 2 == 0 ? -0.31 : 0.31
            let fz: f32 = i < 2 ? -0.3 : 0.3
            turned(ChairFeetPart, foot[0..foot.len], Vec3(fx, 0.0, fz), 0.3 + i as f32 * 0.21)

    fn lamp()
        let at = Vec3(lamp_at().x, RoomFloor, lamp_at().z)
        let stand = [Vec2(0.0, 0.0), Vec2(0.14, 0.0), Vec2(0.145, 0.01), Vec2(0.13, 0.025), Vec2(0.03, 0.04), Vec2(0.018, 0.07), Vec2(0.012, 0.09), Vec2(0.012, 1.3), Vec2(0.02, 1.31), Vec2(0.02, 1.33), Vec2(0.008, 1.34), Vec2(0.008, 1.46), Vec2(0.0, 1.46)]
        turned(BrassPart, stand[0..stand.len], at, 0.0)
        part.clear()
        add_frustum(&part, 0.21, 0.14, 0.26, 48, false)
        parts[ShadePart].append(&part, Mat4.translation(at + Vec3(0.0, 1.43, 0.0)))

    fn pendant()
        let bulb = pendant_at()
        let top = bulb.y + 0.12
        let h = RoomFloor + RoomHigh - top
        let rod = [Vec2(0.0, 0.0), Vec2(0.03, 0.0), Vec2(0.032, 0.01), Vec2(0.022, 0.03), Vec2(0.008, 0.045), Vec2(0.008, h - 0.025), Vec2(0.06, h - 0.018), Vec2(0.07, h - 0.008), Vec2(0.07, h), Vec2(0.0, h)]
        turned(BrassPart, rod[0..rod.len], Vec3(bulb.x, top, bulb.z), 0.0)
        part.clear()
        add_frustum(&part, 0.25, 0.16, 0.2, 48, false)
        parts[ShadePart].append(&part, Mat4.translation(bulb + Vec3(0.0, 0.02, 0.0)))
        add_halo(bulb, 0.3, Color(1.0, 0.8, 0.55, 1.0))

    fn door()
        let x0: f32 = 0.95
        let x1: f32 = 1.85
        let top = RoomFloor + 2.1
        let s = RoomSouth
        let x = Vec3(1.0, 0.0, 0.0)
        let y = Vec3(0.0, 1.0, 0.0)
        block(WalnutPart, Vec3(x0, RoomFloor, s - 0.035), Vec3(x1, top, s), y, 0.12)
        block(WalnutPart, Vec3(x0 - 0.08, RoomFloor, s - 0.05), Vec3(x0, top + 0.08, s), y, 0.27)
        block(WalnutPart, Vec3(x1, RoomFloor, s - 0.05), Vec3(x1 + 0.08, top + 0.08, s), y, 0.31)
        block(WalnutPart, Vec3(x0 - 0.1, top, s - 0.055), Vec3(x1 + 0.1, top + 0.1, s), x, 0.44)
        for row in 0..2
            for col in 0..2
                let left = x0 + 0.1 + col as f32 * 0.37
                let low = RoomFloor + (row == 0 ? 0.15 : 1.05)
                let high: f32 = row == 0 ? 0.75 : 0.9
                block(WalnutPart, Vec3(left, low, s - 0.05), Vec3(left + 0.3, low + high, s - 0.035), y, 0.5 + row as f32 * 0.2 + col as f32 * 0.1)
        part.clear()
        add_sphere(&part, 0.03, 20, 12)
        parts[BrassPart].append(&part, Mat4.translation(Vec3(x1 - 0.09, RoomFloor + 1.0, s - 0.07)))

    fn window()
        let x = Vec3(1.0, 0.0, 0.0)
        let y = Vec3(0.0, 1.0, 0.0)
        let z = Vec3(0.0, 0.0, 1.0)
        let lo = RoomFloor + WindowLow
        let hi = RoomFloor + WindowHigh
        let e = RoomEast
        block(GlassPart, Vec3(e + 0.1, lo, WindowFrom), Vec3(e + 0.11, hi, WindowTo), y, 0.0)
        block(WalnutPart, Vec3(e - 0.03, lo, WindowFrom - 0.08), Vec3(e + 0.02, hi + 0.08, WindowFrom), y, 0.17)
        block(WalnutPart, Vec3(e - 0.03, lo, WindowTo), Vec3(e + 0.02, hi + 0.08, WindowTo + 0.08), y, 0.23)
        block(WalnutPart, Vec3(e - 0.03, hi, WindowFrom), Vec3(e + 0.02, hi + 0.08, WindowTo), z, 0.29)
        block(WalnutPart, Vec3(e - 0.12, lo - 0.04, WindowFrom - 0.12), Vec3(e + 0.1, lo, WindowTo + 0.12), z, 0.41)
        let mid = (WindowFrom + WindowTo) * 0.5
        block(WalnutPart, Vec3(e + 0.08, lo, mid - 0.025), Vec3(e + 0.13, hi, mid + 0.025), y, 0.53)
        for k in 1..3
            let h = lo + (hi - lo) * k as f32 / 3.0
            block(WalnutPart, Vec3(e + 0.085, h - 0.012, WindowFrom), Vec3(e + 0.125, h + 0.012, WindowTo), z, 0.59 + k as f32 * 0.1)
        block(WalnutPart, Vec3(e + 0.08, lo, WindowFrom), Vec3(e + 0.13, lo + 0.05, WindowTo), z, 0.83)
        block(WalnutPart, Vec3(e + 0.08, hi - 0.05, WindowFrom), Vec3(e + 0.13, hi, WindowTo), z, 0.87)
        let rod_y = RoomFloor + 2.42
        block(BrassPart, Vec3(e - 0.115, rod_y - 0.012, WindowFrom - 0.7), Vec3(e - 0.09, rod_y + 0.012, WindowTo + 0.7), z, 0.0)
        for end in [WindowFrom - 0.72, WindowTo + 0.72]
            part.clear()
            add_sphere(&part, 0.03, 20, 12)
            parts[BrassPart].append(&part, Mat4.translation(Vec3(e - 0.1, rod_y, end)))
        part.clear()
        add_curtain(&part, e - 0.14, WindowFrom - 0.68, WindowFrom + 0.08, RoomFloor + 0.01, rod_y - 0.02)
        add_curtain(&part, e - 0.14, WindowTo - 0.08, WindowTo + 0.68, RoomFloor + 0.01, rod_y - 0.02)
        part.compute_normals()
        parts[CurtainPart].append(&part, Mat4.identity())

    fn bookcase(run: ShelfRun)
        var s = run
        let k = WalnutPart
        let bays = max(1, floor(s.length / 0.85 + 0.5) as int)
        let wide = s.length / bays as f32
        let seed = random(0.0, 1.0)
        run_block(k, &s, 0.0, s.length, 0.0, 0.1, 0.0, s.deep - 0.03, false, seed)
        run_block(k, &s, 0.0, s.length, 0.1, 0.125, 0.0, s.deep, false, seed + 0.1)
        run_block(k, &s, 0.0, s.length, 0.0, s.high, 0.0, 0.012, true, seed + 0.2)
        run_block(k, &s, -0.02, s.length + 0.02, s.high - 0.035, s.high, 0.0, s.deep + 0.02, false, seed + 0.3)
        run_block(k, &s, -0.035, s.length + 0.035, s.high, s.high + 0.05, 0.0, s.deep + 0.035, false, seed + 0.4)
        for d in 0..bays + 1
            let t: f32 = d == 0 or d == bays ? 0.03 : 0.022
            let u = clamp(d as f32 * wide - t * 0.5, 0.0, s.length - t)
            run_block(k, &s, u, u + t, 0.1, s.high - 0.035, 0.0, s.deep, true, seed + 0.5 + d as f32 * 0.07)
        let gap = (s.high - 0.035 - 0.125) / s.shelves as f32
        for b in 0..bays
            let u0 = b as f32 * wide + (b == 0 ? 0.03 : 0.011)
            let u1 = (b + 1) as f32 * wide - (b == bays - 1 ? 0.03 : 0.011)
            for f in 0..s.shelves
                let base = 0.125 + f as f32 * gap
                if f > 0: run_block(k, &s, u0, u1, base - 0.022, base, 0.012, s.deep - 0.005, false, random(0.0, 1.0))
                let clear = f < s.shelves - 1 ? gap - 0.022 : gap
                fill_shelf(&s, u0, u1, base, clear)

    fn run_block(k: int, s: *ShelfRun, u0: f32, u1: f32, v0: f32, v1: f32, w0: f32, w1: f32, upright: bool, seed: f32)
        let a = s.at(u0, v0, w0)
        let b = s.at(u1, v1, w1)
        let grain = upright ? Vec3(0.0, 1.0, 0.0) : Vec3(abs(s.along.x), 0.0, abs(s.along.z))
        block(k, lowest(a, b), highest(a, b), grain, seed)

    fn fill_shelf(s: *ShelfRun, u0: f32, u1: f32, base: f32, clear: f32)
        var end = u1
        if random(0.0, 1.0) < 0.18
            end = u1 - random(0.22, 0.3)
            stack_books(s, end + 0.02, u1, base, clear)
        var u = u0 + random(0.0, 0.03)
        var set_left = 0
        var set_tint = Color(0.0, 0.0, 0.0, 1.0)
        var set_high: f32 = 0.0
        var set_deep: f32 = 0.0
        var set_thick: f32 = 0.0
        var set_seed: f32 = 0.0
        while u < end - 0.015
            if set_left == 0 and random(0.0, 1.0) < 0.05
                u += random(0.03, 0.12)
                continue
            if set_left == 0 and random(0.0, 1.0) < 0.3
                set_left = 3 + (random(0.0, 1.0) * 7.0) as int
                set_tint = book_colour()
                set_high = random(0.18, 0.3)
                set_deep = random(0.13, 0.21)
                set_thick = random(0.025, 0.045)
                set_seed = random(0.0, 1.0)
            var tint = book_colour()
            var high = random(0.16, 0.31)
            var deep = random(0.12, 0.22)
            var thick = random(0.016, 0.055)
            var seed = random(0.0, 1.0)
            if set_left > 0
                tint = set_tint
                high = set_high
                deep = set_deep
                thick = set_thick * random(0.85, 1.15)
                seed = set_seed + random(0.0, 0.002)
                set_left -= 1
            high = min(high, clear - 0.015)
            deep = min(deep, s.deep - 0.03)
            if u + thick > end: break
            let w = s.deep - 0.012 - deep * 0.5 - random(0.0, 0.015)
            put_book(s.at(u + thick * 0.5, base + high * 0.5, w), Quat.from_basis(s.along, Vec3(0.0, 1.0, 0.0), s.out), Vec3(thick, high, deep), tint, seed)
            u += thick + random(0.0, 0.003)

    fn stack_books(s: *ShelfRun, u0: f32, u1: f32, base: f32, clear: f32)
        var y = base
        let count = 2 + (random(0.0, 1.0) * 4.0) as int
        let lying = Quat.from_basis(Vec3(0.0, 1.0, 0.0), s.along * -1.0, s.out)
        for i in 0..count
            let thick = random(0.025, 0.05)
            if y + thick > base + clear - 0.01: return
            let long = min(random(0.2, u1 - u0), u1 - u0)
            let deep = random(0.14, min(0.22, s.deep - 0.03))
            let w = s.deep - 0.012 - deep * 0.5 - random(0.0, 0.02)
            put_book(s.at((u0 + u1) * 0.5 + random(-0.01, 0.01), y + thick * 0.5, w), lying, Vec3(thick, long, deep), book_colour(), random(0.0, 1.0))
            y += thick

    fn put_book(at: Vec3, turn: Quat, size: Vec3, tint: Color, seed: f32)
        if book_count >= RoomBooks: return
        books[book_count] = Mat4.trs(at * Metre, turn, size * Metre)
        book_tints[book_count] = tint.with_alpha(seed)
        book_count += 1

    fn book_colour() -> Color
        let hexes = [0x5B1A18, 0x1F3A2A, 0x1B2A44, 0x8A6A44, 0x4A3020, 0x161412, 0x9A7A30, 0x24504E, 0x6E2A2A, 0xC9B99A, 0x4A5868, 0x4A1424, 0x4E4A26, 0x8A4322, 0xB8A888, 0x2E2A40]
        let pick = min((random(0.0, 1.0) * hexes.len as f32) as int, hexes.len as int - 1)
        let c = Color.hex(hexes[pick] as u32)
        let k = random(0.8, 1.15)
        return Color(min(c.r * k, 1.0), min(c.g * k, 1.0), min(c.b * k, 1.0), 1.0)

fn add_curtain(m: *Mesh, x: f32, z0: f32, z1: f32, y0: f32, y1: f32)
    let start = m.vertex_count as u32
    let across = 96
    let down = 24
    let folds = (z1 - z0) / 0.11
    for j in 0..down + 1
        let v = j as f32 / down as f32
        let y = y0 + (y1 - y0) * v
        for i in 0..across + 1
            let u = i as f32 / across as f32
            let z = z0 + (z1 - z0) * u
            let fold = sin(u * folds * Tau) * (0.03 + 0.012 * (1.0 - v)) + sin(u * folds * 2.3 * Tau + v * 2.0) * 0.006
            m.vertex(Vec3(x - fold, y, z), Vec3(-1.0, 0.0, 0.0), Vec2(u, v))
    let row = (across + 1) as u32
    for j in 0..down
        for i in 0..across
            let a = start + j as u32 * row + i as u32
            m.quad(a, a + 1, a + row + 1, a + row)

fn add_rounded_box(m: *Mesh, half: Vec3, round: f32, steps: int)
    let r = min(round, min(half.x, min(half.y, half.z)))
    let inner = half - Vec3.splat(r)
    var normals = [Vec3(1.0, 0.0, 0.0), Vec3(-1.0, 0.0, 0.0), Vec3(0.0, 1.0, 0.0), Vec3(0.0, -1.0, 0.0), Vec3(0.0, 0.0, 1.0), Vec3(0.0, 0.0, -1.0)]
    let side = (steps + 1) * 2
    let row = side as u32
    for face in 0..6
        let n = normals[face]
        let u = abs(n.y) > 0.5 ? Vec3(1.0, 0.0, 0.0) : Vec3(0.0, 1.0, 0.0).cross(n)
        let v = n.cross(u)
        let start = m.vertex_count as u32
        for j in 0..side
            for i in 0..side
                let p = n * box_reach(half, n) + u * rounded_line(i, steps, box_reach(inner, u), r) + v * rounded_line(j, steps, box_reach(inner, v), r)
                let core = Vec3(clamp(p.x, -inner.x, inner.x), clamp(p.y, -inner.y, inner.y), clamp(p.z, -inner.z, inner.z))
                let out = (p - core).normalized
                m.vertex(core + out * r, out, Vec2(i as f32 / (side - 1) as f32, j as f32 / (side - 1) as f32))
        for j in 0..side - 1
            for i in 0..side - 1
                let a = start + j as u32 * row + i as u32
                m.quad(a, a + 1, a + row + 1, a + row)

fn box_reach(half: Vec3, axis: Vec3) -> f32
    return abs(axis.x) * half.x + abs(axis.y) * half.y + abs(axis.z) * half.z

fn rounded_line(k: int, steps: int, inner: f32, r: f32) -> f32
    if k <= steps: return -(inner + r * tan(Pi * 0.25 * (steps - k) as f32 / steps as f32))
    return inner + r * tan(Pi * 0.25 * (k - steps - 1) as f32 / steps as f32)
