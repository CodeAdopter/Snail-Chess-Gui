fn den_hash(h: u64, v: u64) -> u64
    return (h ^ v) * 0x100000001B3

fn den_add_square(t: *ShortText, sq: int)
    t.add(('a' as int + sq % 8) as u8)
    t.add(('1' as int + sq / 8) as u8)
