use engine/scene/camera
use engine/ui/text_cache

const MaxSceneParts = 160
const MaxPartCuts = 320

# The most rects of the picture a frame is drawn again in, and what drawing one more costs, as a
# share of the picture's pixels drawn, little as each is only wiped and finished on its own
const MaxCuts = 8
const CutCost: f32 = 0.002

const PartWhole = 0
const PartSome = 1
const PartNone = 2

const NoRect = Vec4(1.0e9, 1.0e9, -1.0e9, -1.0e9)

# The board scene's picture as parts that can change alone, such as a piece, an arrow or the
# clock, each a key, the rect of pixels it can touch as x0 y0 x1 y1, the rect of shadow map texels
# it casts into, and base, a key of all the rest. A frame whose base matches the one drawn last
# draws again only where parts came, went or changed. Full when a part could not be placed on the
# picture.
struct SceneParts
    keys: [MaxSceneParts]u64
    rects: [MaxSceneParts]Vec4
    lights: [MaxSceneParts]Vec4
    count: int
    base: u64
    full: bool

    fn clear(b: u64)
        count = 0
        base = b
        full = false

    fn add(key: u64, rect: Vec4, light: Vec4 = NoRect)
        if count == MaxSceneParts
            full = true
            return
        keys[count] = key
        rects[count] = rect
        lights[count] = light
        count += 1

    fn take(from: *SceneParts)
        count = from.count
        base = from.base
        full = from.full
        for i in 0..count
            keys[i] = from.keys[i]
            rects[i] = from.rects[i]
            lights[i] = from.lights[i]

# Rects of pixels or shadow map texels, each x0 y0 x1 y1, that a frame drawn in parts draws again.
struct PartCuts
    rects: [MaxPartCuts]Vec4
    count: int

    # r on whole pixels within w by h, kept unless nothing of it is left
    fn add(r: Vec4, w: f32, h: f32)
        let c = Vec4(max(floor(r.x), 0.0), max(floor(r.y), 0.0), min(ceil(r.z), w), min(ceil(r.w), h))
        if c.x >= c.z or c.y >= c.w or count == MaxPartCuts: return
        rects[count] = c
        count += 1

    # Two rects at a time made one while drawing them as one draws no more than cost pixels beyond
    # drawing them apart, or while more than most are left, the pair that grows least first.
    fn merge(cost: f32, most: int)
        while count > 1
            var least: f32 = 1.0e30
            var a = 0
            var b = 1
            for i in 0..count
                for j in i + 1..count
                    let grows = rect_area(rect_union(rects[i], rects[j])) - rect_area(rects[i]) - rect_area(rects[j])
                    if grows >= least: continue
                    least = grows
                    a = i
                    b = j
            if least > cost and count <= most: return
            rects[a] = rect_union(rects[a], rects[b])
            count -= 1
            rects[b] = rects[count]

    fn area() -> f32
        var sum: f32 = 0.0
        for i in 0..count: sum += rect_area(rects[i])
        return sum

    fn meets(r: Vec4) -> bool
        for i in 0..count
            if rects_meet(r, rects[i]): return true
        return false

# The parts one of was and now holds and the other does not, their pixels of a w by h picture into
# seen and their texels of a map by map shadow map into lit.
fn changed_parts(was: *SceneParts, now: *SceneParts, seen: *PartCuts, lit: *PartCuts, w: f32, h: f32, map: f32)
    seen.count = 0
    lit.count = 0
    var taken: [MaxSceneParts]bool
    for i in 0..now.count
        var found = false
        for j in 0..was.count
            if taken[j] or was.keys[j] != now.keys[i]: continue
            taken[j] = true
            found = true
            break
        if found: continue
        seen.add(now.rects[i], w, h)
        lit.add(now.lights[i], map, map)
    for j in 0..was.count
        if taken[j]: continue
        seen.add(was.rects[j], w, h)
        lit.add(was.lights[j], map, map)

# h with w mixed in so that every bit of w stirs every bit of the result. hash_word's multiply
# alone carries a change only toward the high bits, where two changes can cancel: a piece moved to
# the square mirrored through the board's middle flips the sign bits of both x and z, and kept its
# key.
fn mix_word(h: u64, w: u64) -> u64
    var x = (h ^ w) * 0x9E3779B97F4A7C15
    x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9
    x = (x ^ (x >> 27)) * 0x94D049BB133111EB
    return x ^ (x >> 31)

# h with two floats hashed in by their exact bits, so a part that moves by the least amount is
# drawn again, as even that shifts its shading
fn hash_floats(h: u64, a: f32, b: f32) -> u64
    return mix_word(h, (f32_bits(a) as u64) << 32 | f32_bits(b) as u64)

fn hash_color(h: u64, c: Color) -> u64
    return hash_floats(hash_floats(h, c.r, c.g), c.b, c.a)

fn rect_union(a: Vec4, b: Vec4) -> Vec4
    return Vec4(min(a.x, b.x), min(a.y, b.y), max(a.z, b.z), max(a.w, b.w))

fn rects_meet(a: Vec4, b: Vec4) -> bool
    return a.x < b.z and a.z > b.x and a.y < b.w and a.w > b.y

fn rect_area(r: Vec4) -> f32
    return (r.z - r.x) * (r.w - r.y)

# The pixels of a w by h picture seen by camera that a box from lo to hi covers, and when it casts,
# the shadow it throws along sun down to floor as well. The whole picture when a corner lies behind
# the eye.
fn seen_rect(camera: *Camera, lo: Vec3, hi: Vec3, w: f32, h: f32, sun: Vec3, floor: f32, casts: bool) -> Vec4
    var r = Vec4(1.0e9, 1.0e9, -1.0e9, -1.0e9)
    let corners = casts ? 16 : 8
    for k in 0..corners
        var p = Vec3((k & 1) == 0 ? lo.x : hi.x, (k & 2) == 0 ? lo.y : hi.y, (k & 4) == 0 ? lo.z : hi.z)
        if k >= 8: p = p - sun * ((p.y - floor) / sun.y)
        let (seen, at) = camera.screen_point(p, w, h)
        if not seen: return Vec4(0.0, 0.0, w, h)
        r = Vec4(min(r.x, at.x), min(r.y, at.y), max(r.z, at.x), max(r.w, at.y))
    return Vec4(r.x - 2.0, r.y - 2.0, r.z + 2.0, r.w + 2.0)

# The texels of a w by h shadow map, seen through to_map from the world to its texture, that a
# box from lo to hi covers, with room for the map's soft edge.
fn map_rect(to_map: Mat4, lo: Vec3, hi: Vec3, w: f32, h: f32) -> Vec4
    var r = NoRect
    for k in 0..8
        let p = Vec3((k & 1) == 0 ? lo.x : hi.x, (k & 2) == 0 ? lo.y : hi.y, (k & 4) == 0 ? lo.z : hi.z)
        let at = to_map * Vec4.of(p, 1.0)
        r = Vec4(min(r.x, at.x * w), min(r.y, at.y * h), max(r.z, at.x * w), max(r.w, at.y * h))
    return Vec4(r.x - 6.0, r.y - 6.0, r.z + 6.0, r.w + 6.0)
