use src/board3d/room_shapes
use src/board3d/den_screen

const DenWest: f32 = -1.9
const DenEast: f32 = 1.75
const DenNorth: f32 = -1.0
const DenSouth: f32 = 2.7
const DenHigh: f32 = 2.45
const DenDeskTop: f32 = 0.745

const DenWindowFrom: f32 = -0.85
const DenWindowTo: f32 = 0.25
const DenWindowLow: f32 = 0.95
const DenWindowHigh: f32 = 2.05

const DenGlassW: f32 = 0.335
const DenGlassH: f32 = 0.255
const DenGlassY: f32 = 0.995
const DenGlassZ: f32 = -0.514
const DenBulge: f32 = 0.012

const DenCarpetPart = 0
const DenWallPart = 1
const DenCeilingPart = 2
const DenDeskPart = 3
const DenPlasticPart = 4
const DenGlassPart = 5
const DenKeysPart = 6
const DenMetalPart = 7
const DenWindowPart = 8
const DenFabricPart = 9
const DenPosterPart = 10
const DenLavaPart = 11
const DenLedPart = 12
const DenPaperPart = 13
const DenDiscPart = 14
const DenTvPart = 15
const DenCorkPart = 16
const DenWoodPart = 17
const DenShadePart = 18
const DenParts = 19

const DenHalos = 4

const DenMarsDesign = 0
const DenTableDesign = 1
const DenMagazineDesign = 2
const DenFloppyDesign = 3
const DenSleeveDesign = 4
const DenPrintDesign = 5
const DenPhotoDesign = 6
const DenDiagramDesign = 7
const DenStickyDesign = 8
const DenTicketDesign = 9

fn den_lamp_at() -> Vec3
    return Vec3(-0.43, DenDeskTop + 0.385, -0.47)

fn den_lamp_way() -> Vec3
    return Vec3(0.22, -0.42, 0.12).normalized

fn den_lava_at() -> Vec3
    return Vec3(-1.67, 0.52, -0.55)

fn den_street_at() -> Vec3
    return Vec3(-6.5, 3.6, -1.2)

fn den_disc_at() -> Vec3
    return Vec3(0.6, DenDeskTop + 0.0075, -0.6)

fn den_sight(k: int) -> Vec3
    if k == 0: return Vec3(-1.9, 1.2, 1.55)
    if k == 1: return den_lava_at() + Vec3(0.0, 0.26, 0.0)
    if k == 3: return den_disc_at()
    if k == 4: return Vec3(1.4, 0.72, 1.1)
    return Vec3(0.0, DenGlassY - 0.02, DenGlassZ)

struct DenBuild
    parts: [DenParts]Mesh
    part: Mesh
    halos: [DenHalos]RoomFlame
    halo_tints: [DenHalos]Color
    halo_count: int
    disc: int
    rng: Mulberry32

    fn init(kind: int)
        for k in 0..DenParts: parts[k].init(4096, 16384)
        part.init(4096, 16384)
        disc = kind
        rng = Mulberry32(0xD3A2003)

    fn free_parts()
        for k in 0..DenParts: parts[k].free_all()
        part.free_all()

    fn random(lo: f32, hi: f32) -> f32
        return lo + (hi - lo) * rng.next() as f32

    fn build()
        room()
        desk()
        monitor()
        desk_things()
        tower()
        window()
        nightstand()
        bed()
        tv_corner()
        shelf()
        walls_things()

    fn scale_all()
        let s = Mat4.trs(Vec3(0.0, 0.0, 0.0), Quat.identity(), Vec3.splat(Metre))
        for k in 0..DenParts: parts[k].transform(s)

    fn box(k: int, low: Vec3, high: Vec3, tint: Color)
        part.clear()
        part.set_color(tint)
        add_box(&part, high - low)
        parts[k].append(&part, Mat4.translation((low + high) * 0.5))

    fn wood(k: int, low: Vec3, high: Vec3, grain: Vec3, seed: f32)
        box(k, low, high, Color(grain.x, grain.y, grain.z, seed - floor(seed)))

    fn soft(k: int, at: Vec3, half: Vec3, round: f32, tint: Color, turn: Quat = Quat.identity())
        part.clear()
        part.set_color(tint)
        add_rounded_box(&part, half, round, 3)
        parts[k].append(&part, Mat4.trs(at, turn, Vec3.splat(1.0)))

    fn turned(k: int, profile: []Vec2, at: Vec3, tint: Color, up: Vec3 = Vec3(0.0, 1.0, 0.0))
        part.clear()
        part.set_color(tint)
        add_lathe(&part, profile, 32)
        parts[k].append(&part, Mat4.trs(at, Quat.between(Vec3(0.0, 1.0, 0.0), up), Vec3.splat(1.0)))

    fn rod(k: int, from: Vec3, to: Vec3, radius: f32, tint: Color)
        part.clear()
        part.set_color(tint)
        add_capsule(&part, radius, (to - from).length, 12, 6)
        parts[k].append(&part, Mat4.trs((from + to) * 0.5, Quat.between(Vec3(0.0, 1.0, 0.0), (to - from).normalized), Vec3.splat(1.0)))

    fn ball(k: int, at: Vec3, radius: f32, tint: Color)
        part.clear()
        part.set_color(tint)
        add_sphere(&part, radius, 12, 8)
        parts[k].append(&part, Mat4.translation(at))

    fn sheet(k: int, at: Vec3, right: Vec3, up: Vec3, w: f32, h: f32, design: int, tint: Color = Color(1.0, 1.0, 1.0, 1.0))
        let n = right.cross(up).normalized
        let r = right * (w * 0.5)
        let u = up * (h * 0.5)
        let c = Color(tint.r, tint.g, tint.b, (design as f32 + 0.5) / 16.0)
        part.clear()
        part.set_color(c)
        let a = part.vertex(at - r - u, n, Vec2(0.0, 0.0))
        let b = part.vertex(at + r - u, n, Vec2(1.0, 0.0))
        let d = part.vertex(at + r + u, n, Vec2(1.0, 1.0))
        let e = part.vertex(at - r + u, n, Vec2(0.0, 1.0))
        part.quad(a, b, d, e)
        parts[k].append(&part, Mat4.identity())

    fn face(k: int, a: Vec3, b: Vec3, c: Vec3, d: Vec3, middle: Vec3, tint: Color)
        var p = [a, b, c, d]
        var n = (b - a).cross(d - a).normalized
        if n.dot((a + c) * 0.5 - middle) < 0.0
            p = [a, d, c, b]
            n = n * -1.0
        part.clear()
        part.set_color(tint)
        let i0 = part.vertex(p[0], n, Vec2(0.0, 0.0))
        let i1 = part.vertex(p[1], n, Vec2(1.0, 0.0))
        let i2 = part.vertex(p[2], n, Vec2(1.0, 1.0))
        let i3 = part.vertex(p[3], n, Vec2(0.0, 1.0))
        part.quad(i0, i1, i2, i3)
        parts[k].append(&part, Mat4.identity())

    fn taper(k: int, front: Vec3, fh: Vec2, back: Vec3, bh: Vec2, tint: Color)
        var c: [8]Vec3
        for i in 0..4
            let sx: f32 = i == 0 or i == 3 ? -1.0 : 1.0
            let sy: f32 = i < 2 ? -1.0 : 1.0
            c[i] = front + Vec3(sx * fh.x, sy * fh.y, 0.0)
            c[i + 4] = back + Vec3(sx * bh.x, sy * bh.y, 0.0)
        let middle = (front + back) * 0.5
        face(k, c[0], c[1], c[2], c[3], middle, tint)
        face(k, c[4], c[5], c[6], c[7], middle, tint)
        face(k, c[0], c[1], c[5], c[4], middle, tint)
        face(k, c[3], c[2], c[6], c[7], middle, tint)
        face(k, c[0], c[3], c[7], c[4], middle, tint)
        face(k, c[1], c[2], c[6], c[5], middle, tint)

    fn add_halo(at: Vec3, size: f32, tint: Color)
        if halo_count >= DenHalos: return
        halos[halo_count] = RoomFlame(at * Metre, Vec2(size, size) * Metre, 0.0)
        halo_tints[halo_count] = tint
        halo_count += 1

    fn room()
        let top = DenHigh
        let white = Color(1.0, 1.0, 1.0, 1.0)
        part.clear()
        part.set_color(white)
        add_plane(&part, DenEast - DenWest, DenSouth - DenNorth, 1, 1)
        parts[DenCarpetPart].append(&part, Mat4.translation(Vec3((DenWest + DenEast) * 0.5, 0.0, (DenNorth + DenSouth) * 0.5)))
        let k = DenWallPart
        box(k, Vec3(DenWest - 0.2, 0.0, DenNorth - 0.2), Vec3(DenEast + 0.2, top, DenNorth), white)
        box(k, Vec3(DenWest - 0.2, 0.0, DenSouth), Vec3(DenEast + 0.2, top, DenSouth + 0.2), white)
        box(k, Vec3(DenEast, 0.0, DenNorth), Vec3(DenEast + 0.2, top, DenSouth), white)
        box(k, Vec3(DenWest - 0.2, 0.0, DenNorth), Vec3(DenWest, top, DenWindowFrom), white)
        box(k, Vec3(DenWest - 0.2, 0.0, DenWindowTo), Vec3(DenWest, top, DenSouth), white)
        box(k, Vec3(DenWest - 0.2, 0.0, DenWindowFrom), Vec3(DenWest, DenWindowLow, DenWindowTo), white)
        box(k, Vec3(DenWest - 0.2, DenWindowHigh, DenWindowFrom), Vec3(DenWest, top, DenWindowTo), white)
        box(DenCeilingPart, Vec3(DenWest, top, DenNorth), Vec3(DenEast, top + 0.1, DenSouth), white)
        part.clear()
        part.set_color(Color.hex(0xEDEAE2))
        add_sphere(&part, 1.0, 24, 12)
        parts[DenPlasticPart].append(&part, Mat4.trs(Vec3(0.0, top, 0.7), Quat.identity(), Vec3(0.2, 0.07, 0.2)))

    fn desk()
        let t = DenDeskTop
        let x = Vec3(1.0, 0.0, 0.0)
        let y = Vec3(0.0, 1.0, 0.0)
        wood(DenDeskPart, Vec3(-0.8, t - 0.028, -1.0), Vec3(0.8, t, -0.2), x, 0.31)
        wood(DenDeskPart, Vec3(-0.8, 0.0, -1.0), Vec3(-0.778, t - 0.028, -0.22), y, 0.57)
        wood(DenDeskPart, Vec3(0.778, 0.0, -1.0), Vec3(0.8, t - 0.028, -0.22), y, 0.73)
        wood(DenDeskPart, Vec3(-0.778, 0.3, -0.99), Vec3(0.778, t - 0.028, -0.972), x, 0.19)

    fn monitor()
        let t = DenDeskTop
        let beige = Color.hex(0xD9D1BC).with_alpha(0.55)
        let darker = Color.hex(0xBDB49C).with_alpha(0.6)
        soft(DenPlasticPart, Vec3(0.0, t + 0.008, -0.73), Vec3(0.13, 0.008, 0.12), 0.007, beige)
        soft(DenPlasticPart, Vec3(0.0, t + 0.028, -0.73), Vec3(0.075, 0.016, 0.09), 0.012, beige)
        let cy = DenGlassY
        let gx = DenGlassW * 0.5
        let g0 = cy - DenGlassH * 0.5
        let g1 = cy + DenGlassH * 0.5
        let low = t + 0.045
        let high: f32 = 1.185
        let bx: f32 = 0.205
        let z: f32 = -0.527
        let d: f32 = 0.027
        soft(DenPlasticPart, Vec3(0.0, (g1 + high) * 0.5, z), Vec3(bx, (high - g1) * 0.5 + 0.004, d), 0.009, beige)
        soft(DenPlasticPart, Vec3(0.0, (low + g0) * 0.5, z), Vec3(bx, (g0 - low) * 0.5 + 0.004, d), 0.009, beige)
        for i in 0..2
            let side: f32 = i == 0 ? -1.0 : 1.0
            soft(DenPlasticPart, Vec3(side * (gx + bx) * 0.5, cy, z), Vec3((bx - gx) * 0.5 + 0.004, (g1 - g0) * 0.5 + 0.006, d), 0.006, beige)
        box(DenPlasticPart, Vec3(-gx - 0.01, g0 - 0.01, -0.55), Vec3(gx + 0.01, g1 + 0.01, DenGlassZ - 0.004), Color.hex(0x1A1A1A).with_alpha(0.5))
        taper(DenPlasticPart, Vec3(0.0, (low + high) * 0.5, z - d), Vec2(bx - 0.006, (high - low) * 0.5 - 0.006), Vec3(0.0, 0.975, -0.95), Vec2(0.13, 0.115), beige)
        soft(DenPlasticPart, Vec3(0.15, low + 0.03, z + d), Vec3(0.013, 0.009, 0.004), 0.004, darker)
        for i in 0..4: soft(DenPlasticPart, Vec3(-0.075 + i as f32 * 0.03, low + 0.03, z + d), Vec3(0.009, 0.005, 0.003), 0.003, darker)
        box(DenLedPart, Vec3(0.122, low + 0.027, z + d - 0.002), Vec3(0.128, low + 0.033, z + d + 0.0015), Color(0.2, 1.0, 0.25, 1.0))
        add_halo(Vec3(0.125, low + 0.03, z + d + 0.004), 0.025, Color(0.2, 1.0, 0.3, 1.0))
        part.clear()
        part.set_color(Color(1.0, 1.0, 1.0, 1.0))
        let nx = 32
        let ny = 24
        for j in 0..ny + 1
            for i in 0..nx + 1
                let u = i as f32 / nx as f32
                let v = j as f32 / ny as f32
                let sx = u * 2.0 - 1.0
                let sy = 1.0 - v * 2.0
                let lift = DenBulge * (1.0 - sx * sx * 0.85) * (1.0 - sy * sy * 0.85)
                let dx = DenBulge * -1.7 * sx * (1.0 - sy * sy * 0.85) / DenGlassW * 2.0
                let dy = DenBulge * -1.7 * sy * (1.0 - sx * sx * 0.85) / DenGlassH * 2.0
                let at = Vec3(sx * gx, cy + sy * DenGlassH * 0.5, DenGlassZ + lift)
                let n = Vec3(-dx, -dy, 1.0).normalized
                let made = part.vertex(at, n, Vec2(u, v))
        for j in 0..ny
            for i in 0..nx
                let a = j * (nx + 1) + i
                part.quad((a + nx + 1) as u32, (a + nx + 2) as u32, (a + 1) as u32, a as u32)
        parts[DenGlassPart].append(&part, Mat4.identity())
        let up = Vec3(0.0, 1.0, 0.0)
        let note = Quat.axis_angle(Vec3(0.0, 0.0, 1.0), 0.12)
        sheet(DenPaperPart, Vec3(-0.17, 1.15, z + d + 0.0015), note * Vec3(1.0, 0.0, 0.0), note * up, 0.06, 0.06, DenStickyDesign, Color.hex(0xFFE873))
        let tilt = Quat.axis_angle(Vec3(0.0, 0.0, 1.0), -0.08)
        sheet(DenPaperPart, Vec3(0.186, 0.93, z + d + 0.0015), tilt * Vec3(1.0, 0.0, 0.0), tilt * up, 0.05, 0.05, DenStickyDesign, Color.hex(0xFFB0C8))

    fn desk_things()
        let t = DenDeskTop
        let beige = Color.hex(0xD9D1BC).with_alpha(0.55)
        let tilt = Quat.axis_angle(Vec3(1.0, 0.0, 0.0), 0.05)
        soft(DenPlasticPart, Vec3(0.0, t + 0.013, -0.33), Vec3(0.235, 0.013, 0.09), 0.006, beige, tilt)
        part.clear()
        part.set_color(Color(1.0, 1.0, 1.0, 1.0))
        add_box(&part, Vec3(0.45, 0.012, 0.155))
        parts[DenKeysPart].append(&part, Mat4.trs(Vec3(0.0, t + 0.026, -0.335), tilt, Vec3.splat(1.0)))
        box(DenFabricPart, Vec3(0.27, t, -0.43), Vec3(0.49, t + 0.003, -0.25), Color.hex(0x23305A).with_alpha(0.13))
        soft(DenPlasticPart, Vec3(0.38, t + 0.017, -0.33), Vec3(0.031, 0.015, 0.052), 0.014, beige, Quat.axis_angle(Vec3(0.0, 1.0, 0.0), 0.1))
        rod(DenPlasticPart, Vec3(0.375, t + 0.006, -0.39), Vec3(0.3, t + 0.006, -0.62), 0.0025, Color.hex(0xC9C1AA))
        for i in 0..2
            let side: f32 = i == 0 ? -1.0 : 1.0
            soft(DenPlasticPart, Vec3(side * 0.33, t + 0.09, -0.66), Vec3(0.05, 0.09, 0.055), 0.008, beige)
            box(DenFabricPart, Vec3(side * 0.33 - 0.04, t + 0.03, -0.606), Vec3(side * 0.33 + 0.04, t + 0.16, -0.603), Color.hex(0x3A3A3A).with_alpha(0.03))
        let metal = Color.hex(0x22262A).with_alpha(0.2)
        let foot = Vec3(-0.62, t, -0.74)
        let elbow = Vec3(-0.6, t + 0.34, -0.64)
        let head = den_lamp_at() - den_lamp_way() * 0.06
        let plate = [Vec2(0.0, 0.0), Vec2(0.075, 0.0), Vec2(0.075, 0.012), Vec2(0.06, 0.022), Vec2(0.0, 0.024)]
        turned(DenMetalPart, plate[0..plate.len], foot, metal)
        rod(DenMetalPart, foot + Vec3(0.0, 0.02, 0.0), elbow, 0.007, metal)
        rod(DenMetalPart, elbow, head, 0.007, metal)
        ball(DenMetalPart, elbow, 0.012, metal)
        let shade = [Vec2(0.078, 0.0), Vec2(0.07, 0.03), Vec2(0.05, 0.08), Vec2(0.03, 0.11), Vec2(0.022, 0.13), Vec2(0.0, 0.14)]
        turned(DenShadePart, shade[0..shade.len], den_lamp_at() + den_lamp_way() * 0.045, Color.hex(0x2F5A3A), den_lamp_way() * -1.0)
        add_halo(den_lamp_at() + den_lamp_way() * 0.03, 0.12, Color(1.0, 0.8, 0.55, 1.0))
        let mug = [Vec2(0.0, 0.0), Vec2(0.036, 0.0), Vec2(0.04, 0.004), Vec2(0.04, 0.095), Vec2(0.036, 0.095), Vec2(0.036, 0.01), Vec2(0.0, 0.01)]
        turned(DenPlasticPart, mug[0..mug.len], Vec3(-0.42, t, -0.4), Color.hex(0xB0282A).with_alpha(0.15))
        part.clear()
        part.set_color(Color.hex(0xB0282A).with_alpha(0.15))
        add_torus(&part, 0.022, 0.006, 16, 8)
        parts[DenPlasticPart].append(&part, Mat4.trs(Vec3(-0.465, t + 0.05, -0.4), Quat.axis_angle(Vec3(1.0, 0.0, 0.0), Pi * 0.5), Vec3.splat(1.0)))
        let turn = Quat.axis_angle(Vec3(0.0, 1.0, 0.0), 0.28)
        let along = turn * Vec3(1.0, 0.0, 0.0)
        let down = turn * Vec3(0.0, 0.0, 1.0)
        sheet(DenPaperPart, Vec3(0.58, t + 0.0045, -0.63), along, down * -1.0, 0.21, 0.28, DenMagazineDesign)
        for i in 0..3
            let lift = 0.0012 + i as f32 * 0.0011
            soft(DenPaperPart, Vec3(0.58, t + lift, -0.63), Vec3(0.105, 0.0006, 0.14), 0.0004, Color(1.0, 1.0, 1.0, (DenPrintDesign as f32 + 0.5) / 16.0), turn)
        let at = den_disc_at()
        if disc == DenFloppy
            let lean = Quat.axis_angle(Vec3(0.0, 1.0, 0.0), -0.3)
            soft(DenPlasticPart, at + Vec3(0.0, 0.0012, 0.0), Vec3(0.045, 0.0017, 0.047), 0.0012, Color.hex(0x24306E).with_alpha(0.35), lean)
            sheet(DenPaperPart, at + lean * Vec3(0.0, 0.0031, 0.012), lean * Vec3(1.0, 0.0, 0.0), lean * Vec3(0.0, 0.0, -1.0), 0.07, 0.05, DenFloppyDesign)
            soft(DenMetalPart, at + lean * Vec3(0.008, 0.0012, -0.03), Vec3(0.028, 0.0019, 0.017), 0.0008, Color.hex(0xB8BCC2).with_alpha(0.85), lean)
        else
            let lean = Quat.axis_angle(Vec3(0.0, 1.0, 0.0), 0.5)
            sheet(DenPaperPart, at + Vec3(-0.03, -0.0015, 0.03), lean * Vec3(1.0, 0.0, 0.0), lean * Vec3(0.0, 0.0, -1.0), 0.125, 0.125, DenSleeveDesign)
            part.clear()
            part.set_color(Color(1.0, 1.0, 1.0, 1.0))
            add_cylinder(&part, 0.06, 0.0012, 48, true)
            parts[DenDiscPart].append(&part, Mat4.translation(at))

    fn tower()
        let beige = Color.hex(0xD6CEB8).with_alpha(0.55)
        let darker = Color.hex(0xC4BBA2).with_alpha(0.6)
        let front: f32 = -0.47
        soft(DenPlasticPart, Vec3(0.96, 0.225, -0.715), Vec3(0.1, 0.225, 0.245), 0.006, beige)
        soft(DenPlasticPart, Vec3(0.96, 0.4, front), Vec3(0.074, 0.019, 0.004), 0.003, darker)
        box(DenPlasticPart, Vec3(0.895, 0.392, front + 0.003), Vec3(1.025, 0.394, front + 0.0045), Color.hex(0x3A3630).with_alpha(0.5))
        soft(DenPlasticPart, Vec3(0.96, 0.35, front), Vec3(0.05, 0.012, 0.004), 0.003, darker)
        box(DenPlasticPart, Vec3(0.93, 0.349, front + 0.003), Vec3(0.99, 0.352, front + 0.0045), Color.hex(0x1A1A1A).with_alpha(0.5))
        soft(DenPlasticPart, Vec3(0.96, 0.24, front), Vec3(0.016, 0.016, 0.005), 0.008, darker)
        box(DenLedPart, Vec3(0.932, 0.196, front + 0.001), Vec3(0.94, 0.202, front + 0.006), Color(0.25, 1.0, 0.3, 1.0))
        box(DenLedPart, Vec3(0.98, 0.196, front + 0.001), Vec3(0.988, 0.202, front + 0.006), Color(1.0, 0.55, 0.1, 0.0))
        for i in 0..6: box(DenPlasticPart, Vec3(0.91, 0.04 + i as f32 * 0.016, front + 0.0), Vec3(1.01, 0.047 + i as f32 * 0.016, front + 0.004), Color.hex(0x8E8672).with_alpha(0.7))

    fn window()
        let white = Color.hex(0xEDEBE4).with_alpha(0.35)
        let w = DenWest
        box(DenPlasticPart, Vec3(w - 0.06, DenWindowLow - 0.035, DenWindowFrom - 0.04), Vec3(w + 0.17, DenWindowLow, DenWindowTo + 0.04), white)
        box(DenPlasticPart, Vec3(w - 0.06, DenWindowHigh, DenWindowFrom), Vec3(w + 0.01, DenWindowHigh + 0.04, DenWindowTo), white)
        box(DenPlasticPart, Vec3(w - 0.06, DenWindowLow, DenWindowFrom), Vec3(w + 0.01, DenWindowHigh, DenWindowFrom + 0.04), white)
        box(DenPlasticPart, Vec3(w - 0.06, DenWindowLow, DenWindowTo - 0.04), Vec3(w + 0.01, DenWindowHigh, DenWindowTo), white)
        box(DenPlasticPart, Vec3(w - 0.06, (DenWindowLow + DenWindowHigh) * 0.5 - 0.02, DenWindowFrom), Vec3(w - 0.02, (DenWindowLow + DenWindowHigh) * 0.5 + 0.02, DenWindowTo), white)
        let mid = Vec3(w - 0.08, (DenWindowLow + DenWindowHigh) * 0.5, (DenWindowFrom + DenWindowTo) * 0.5)
        sheet(DenWindowPart, mid, Vec3(0.0, 0.0, -1.0), Vec3(0.0, 1.0, 0.0), DenWindowTo - DenWindowFrom, DenWindowHigh - DenWindowLow, 0)
        let slat = Color.hex(0xE4E1D6).with_alpha(0.4)
        let long = DenWindowTo - DenWindowFrom - 0.03
        let zc = (DenWindowFrom + DenWindowTo) * 0.5
        box(DenPlasticPart, Vec3(w + 0.04, DenWindowHigh - 0.04, DenWindowFrom + 0.01), Vec3(w + 0.11, DenWindowHigh, DenWindowTo - 0.01), white)
        var y = DenWindowHigh - 0.06
        while y > DenWindowLow + 0.12
            part.clear()
            part.set_color(slat)
            add_box(&part, Vec3(0.026, 0.0012, long))
            parts[DenPlasticPart].append(&part, Mat4.trs(Vec3(w + 0.075, y, zc), Quat.axis_angle(Vec3(0.0, 0.0, 1.0), -0.55), Vec3.splat(1.0)))
            y -= 0.024
        box(DenPlasticPart, Vec3(w + 0.06, y - 0.012, DenWindowFrom + 0.01), Vec3(w + 0.09, y, DenWindowTo - 0.01), white)
        for i in 0..2
            let cz = zc + (i == 0 ? -0.35 : 0.35)
            box(DenPlasticPart, Vec3(w + 0.074, y, cz - 0.001), Vec3(w + 0.076, DenWindowHigh - 0.04, cz + 0.001), white)
        rod(DenPlasticPart, Vec3(w + 0.1, DenWindowHigh - 0.04, DenWindowTo - 0.05), Vec3(w + 0.1, DenWindowLow + 0.35, DenWindowTo - 0.05), 0.0015, white)

    fn nightstand()
        let x = Vec3(1.0, 0.0, 0.0)
        let y = Vec3(0.0, 1.0, 0.0)
        wood(DenWoodPart, Vec3(-1.88, 0.0, -0.78), Vec3(-1.45, 0.52, -0.32), y, 0.41)
        wood(DenWoodPart, Vec3(-1.45, 0.29, -0.76), Vec3(-1.44, 0.49, -0.34), x, 0.63)
        wood(DenWoodPart, Vec3(-1.45, 0.04, -0.76), Vec3(-1.44, 0.26, -0.34), x, 0.17)
        ball(DenMetalPart, Vec3(-1.435, 0.39, -0.55), 0.01, Color.hex(0xC0B080).with_alpha(0.9))
        ball(DenMetalPart, Vec3(-1.435, 0.15, -0.55), 0.01, Color.hex(0xC0B080).with_alpha(0.9))
        let at = den_lava_at()
        let base = [Vec2(0.0, 0.0), Vec2(0.068, 0.0), Vec2(0.066, 0.01), Vec2(0.04, 0.125), Vec2(0.036, 0.13), Vec2(0.0, 0.13)]
        turned(DenMetalPart, base[0..base.len], at, Color.hex(0x5A3C8C).with_alpha(0.75))
        let bottle = [Vec2(0.0, 0.128), Vec2(0.036, 0.128), Vec2(0.05, 0.17), Vec2(0.058, 0.22), Vec2(0.052, 0.3), Vec2(0.04, 0.37), Vec2(0.026, 0.405), Vec2(0.0, 0.405)]
        turned(DenLavaPart, bottle[0..bottle.len], at, Color(1.0, 1.0, 1.0, 1.0))
        let cap = [Vec2(0.0, 0.4), Vec2(0.028, 0.4), Vec2(0.02, 0.47), Vec2(0.0, 0.47)]
        turned(DenMetalPart, cap[0..cap.len], at, Color.hex(0x5A3C8C).with_alpha(0.75))
        add_halo(at + Vec3(0.0, 0.25, 0.0), 0.5, Color(1.0, 0.35, 0.15, 1.0))

    fn bed()
        let x = Vec3(1.0, 0.0, 0.0)
        let y = Vec3(0.0, 1.0, 0.0)
        let z = Vec3(0.0, 0.0, 1.0)
        wood(DenWoodPart, Vec3(-1.9, 0.08, 0.56), Vec3(-0.95, 0.3, 2.6), z, 0.27)
        wood(DenWoodPart, Vec3(-1.9, 0.0, 0.5), Vec3(-0.95, 0.92, 0.56), y, 0.83)
        wood(DenWoodPart, Vec3(-1.9, 0.0, 2.6), Vec3(-0.95, 0.45, 2.64), y, 0.51)
        soft(DenFabricPart, Vec3(-1.425, 0.39, 1.58), Vec3(0.47, 0.09, 1.0), 0.04, Color.hex(0xE8E4DA).with_alpha(0.03))
        soft(DenFabricPart, Vec3(-1.41, 0.5, 1.78), Vec3(0.5, 0.04, 0.84), 0.035, Color.hex(0x4A7894).with_alpha(0.07))
        soft(DenFabricPart, Vec3(-1.46, 0.53, 0.76), Vec3(0.3, 0.055, 0.16), 0.05, Color.hex(0xF2EFE6).with_alpha(0.03))
        sheet(DenPosterPart, Vec3(DenWest + 0.004, 1.5, 1.55), Vec3(0.0, 0.0, -1.0), Vec3(0.0, 1.0, 0.0), 0.6, 0.86, DenMarsDesign)

    fn tv_corner()
        let y = Vec3(0.0, 1.0, 0.0)
        let z = Vec3(0.0, 0.0, 1.0)
        wood(DenWoodPart, Vec3(1.33, 0.0, 0.62), Vec3(1.75, 0.46, 1.55), z, 0.37)
        wood(DenWoodPart, Vec3(1.325, 0.06, 0.66), Vec3(1.33, 0.4, 1.08), y, 0.91)
        wood(DenWoodPart, Vec3(1.325, 0.06, 1.1), Vec3(1.33, 0.4, 1.51), y, 0.29)
        let dark = Color.hex(0x34363A).with_alpha(0.35)
        soft(DenPlasticPart, Vec3(1.56, 0.65, 0.95), Vec3(0.16, 0.19, 0.21), 0.015, dark)
        taper(DenPlasticPart, Vec3(1.7, 0.65, 0.95), Vec2(0.16, 0.15), Vec3(1.745, 0.66, 0.95), Vec2(0.1, 0.09), dark)
        sheet(DenTvPart, Vec3(1.397, 0.67, 0.93), Vec3(0.0, 0.0, 1.0), Vec3(0.0, 1.0, 0.0), 0.3, 0.23, 0)
        for i in 0..3: soft(DenPlasticPart, Vec3(1.398, 0.5 + 0.0, 1.06 + i as f32 * 0.025), Vec3(0.004, 0.006, 0.008), 0.003, Color.hex(0x202022).with_alpha(0.5))
        box(DenLedPart, Vec3(1.396, 0.5, 0.83), Vec3(1.402, 0.506, 0.836), Color(1.0, 0.15, 0.1, 1.0))
        let grey = Color.hex(0x9EA0A6).with_alpha(0.45)
        let turn = Quat.axis_angle(Vec3(0.0, 1.0, 0.0), 0.2)
        soft(DenPlasticPart, Vec3(1.55, 0.495, 1.36), Vec3(0.12, 0.035, 0.14), 0.01, grey, turn)
        ball(DenPlasticPart, turn * Vec3(-0.12, 0.0, 0.08) + Vec3(1.55, 0.51, 1.36), 0.012, Color.hex(0x5A5C62).with_alpha(0.4))
        soft(DenPlasticPart, Vec3(1.45, 0.475, 1.42), Vec3(0.05, 0.015, 0.075), 0.014, grey, Quat.axis_angle(Vec3(0.0, 1.0, 0.0), -0.5))
        rod(DenPlasticPart, Vec3(1.47, 0.47, 1.34), Vec3(1.5, 0.465, 1.3), 0.003, Color.hex(0x303032))
        let cx = DenEast - 0.012
        wood(DenWoodPart, Vec3(cx - 0.01, 1.22, 0.58), Vec3(DenEast, 1.82, 1.36), y, 0.75)
        sheet(DenCorkPart, Vec3(cx - 0.012, 1.52, 0.97), Vec3(0.0, 0.0, 1.0), Vec3(0.0, 1.0, 0.0), 0.72, 0.52, 0)
        let notes = [DenDiagramDesign, DenPhotoDesign, DenPrintDesign, DenTicketDesign, DenPhotoDesign, DenPrintDesign]
        let spots = [Vec2(1.57, 0.77), Vec2(1.38, 0.95), Vec2(1.56, 1.1), Vec2(1.36, 1.24), Vec2(1.66, 1.26), Vec2(1.4, 0.7)]
        let sizes = [Vec2(0.17, 0.2), Vec2(0.12, 0.09), Vec2(0.15, 0.2), Vec2(0.13, 0.06), Vec2(0.09, 0.12), Vec2(0.12, 0.16)]
        let pins = [0xD02020, 0x2050D0, 0xE0C020, 0x20A040, 0xD02020, 0x2050D0]
        for i in 0..6
            let s = spots[i]
            let twist = Quat.axis_angle(Vec3(1.0, 0.0, 0.0), random(-0.12, 0.12))
            let px = cx - 0.014 - i as f32 * 0.0006
            sheet(DenPaperPart, Vec3(px, s.x, s.y), twist * Vec3(0.0, 0.0, 1.0), twist * Vec3(0.0, 1.0, 0.0), sizes[i].x, sizes[i].y, notes[i])
            ball(DenPlasticPart, Vec3(px - 0.006, s.x + sizes[i].y * 0.4, s.y), 0.007, Color.hex(pins[i] as u32).with_alpha(0.2))

    fn shelf()
        let x = Vec3(1.0, 0.0, 0.0)
        wood(DenWoodPart, Vec3(1.47, 1.45, -0.95), Vec3(1.75, 1.472, -0.1), Vec3(0.0, 0.0, 1.0), 0.13)
        var z: f32 = -0.92
        let tints = [0x8A1C1C, 0x1C3A8A, 0x2A2A2A, 0xC88A1C, 0x1C6A3A, 0x6A1C6A, 0xE0E0E0, 0x1C1C5A, 0xA03A10]
        for i in 0..9
            let wide = random(0.035, 0.06)
            let tall = random(0.19, 0.24)
            soft(DenPlasticPart, Vec3(1.62, 1.472 + tall * 0.5, z + wide * 0.5), Vec3(0.09, tall * 0.5, wide * 0.5), 0.003, Color.hex(tints[i] as u32).with_alpha(0.4))
            z += wide + 0.004
        for i in 0..7
            soft(DenPlasticPart, Vec3(1.62, 1.478 + i as f32 * 0.0105, -0.3 + random(-0.004, 0.004)), Vec3(0.071, 0.005, 0.062), 0.0015, Color.hex(i % 2 == 0 ? 0x9AA0A8 : 0x2A2C30).with_alpha(0.1))

    fn walls_things()
        sheet(DenPosterPart, Vec3(-0.47, 1.62, DenNorth + 0.004), Vec3(1.0, 0.0, 0.0), Vec3(0.0, 1.0, 0.0), 0.62, 0.44, DenTableDesign)
