use src/app/gui_app

extend GuiApp
    fn start_fastchess()
        fast_ext.install.begin(&data)
        fast_ext.runs = &fast_runs
        settings_page.fast = &fast_ext
        profile_page.fast_history.runs = &fast_runs
        var own: [1024]u8
        let n = sn_fc_own_path(&own[0], 1024)
        fast_runs.start(data.root_text(), str(own[0..n]))
        if has_arg("--fast-go") and not fast_ext.start_match(&library): app.ui.toast("snailfast could not be started.")

    fn run_fastchess()
        if fast_ext.install.update(): app.redraw()
        if fast_ext.open_len > 0: reopen_fast(fast_ext.take_open())
        if profile_page.fast_history.open_len > 0: reopen_fast(profile_page.fast_history.take_open())
        let shown = tabs.current()
        let watching = shown.kind == FastChess and shown.fast != null
        fast_runs.set_gap(not watching ? FastQuietMs : shown.fast_view.eco ? FastEcoMs : FastWatchMs)
        if not fast_runs.update(): return
        for r in fast_runs.fresh
            open_fast(r)
        fast_runs.fresh.clear()
        var titles = false
        for i in 0..tabs.tabs.len
            let t = &tabs.tabs[i]
            if not t.fast: continue
            let live = t.fast.running()
            var title: [64]u8
            let name = fast_tab_title(t.fast, &title)
            if live != t.live or name != t.title_text(): titles = true
            t.live = live
            t.set_title(name)
        if titles or watching: app.redraw()

    fn continue_fast(t: *GuiTab)
        let r = t.fast
        if not r or not r.can_continue(): return
        var exe_buf: [720]u8
        var config_buf: [760]u8
        let exe = fast_runs.place.path("fastchess\\bin\\snailfast.exe", &exe_buf)
        let config = r.file("config.json", &config_buf)
        var line: [1800]u8
        let command = format(&line, "\"{exe}\" -config \"file={config}\" \"outname={config}\"")
        let cwd = str(r.cwd[0..r.cwd.len])
        let folder = r.folder_text()
        if sn_fc_launch(command.ptr, command.len as int, cwd.ptr, cwd.len as int, 1) == 0 and sn_fc_launch(command.ptr, command.len as int, folder.ptr, folder.len as int, 1) == 0
            app.ui.toast("snailfast could not be started.")
            return
        r.continuing = true
        r.continue_ms = sn_fc_now_ms()
        app.redraw()

    fn show_fast_eco(t: *GuiTab, on: bool)
        t.fast_view.eco = on
        fast_runs.set_eco_default(on)
        app.redraw()

    fn open_fast(r: *FastRun)
        let from = tabs.current()
        let keep = from.kind == Play and from.play and from.play.state == PlayRunning or from.kind == Lichess
        let from_id = from.id
        tabs.open(FastChess)
        let t = tabs.current()
        t.fast = r
        t.live = r.running()
        t.fast_view.eco = fast_runs.eco_default()
        t.fast_view.panel = clamp(arg_int("--fast-panel", 0), 0, 3)
        var title: [64]u8
        t.set_title(fast_tab_title(r, &title))
        if keep
            for i in 0..tabs.tabs.len
                if tabs.tabs[i].id == from_id: tabs.active = i as int

    fn reopen_fast(id: str)
        let r = fast_runs.reopen(id)
        if not r
            app.ui.toast("That run could not be read.")
            return
        for i in 0..tabs.tabs.len
            if tabs.tabs[i].fast == r
                tabs.active = i as int
                return
        open_fast(r)
        app.redraw()

    fn tab_lock(t: *GuiTab) -> str
        if t.fast and t.fast.running(): return "Stop the fastchess run first, or let it finish."
        if t.event and (t.event.state == EventRunning or t.event.state == EventPausing): return "Pause or stop the tournament first."
        if t.play and t.play.state == PlayRunning: return "Finish or resign the game first."
        return ""

    fn close_fast(t: *GuiTab)
        if not t.fast: return
        if not t.fast.running(): fast_runs.forget(t.fast)
        t.fast = null
        t.fast_view.release()

    fn release_fastchess()
        for t in tabs.tabs
            t.fast_view.release()
        fast_runs.release()
        fast_ext.release()

fn fast_tab_title(r: *FastRun, buf: *[64]u8) -> str
    let a = &r.args
    let kind = a.sprt ? "SPRT" : "Match"
    if a.engines == 2 and a.first_len > 0 and a.second_len > 0: return format(buf, "{kind} {a.first_name()} vs {a.second_name()}")
    if a.engines > 2: return format(buf, "fastchess, {a.engines} engines")
    return format(buf, "fastchess")
