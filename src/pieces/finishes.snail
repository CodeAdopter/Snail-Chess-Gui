enum PieceFinish: u8
    NoFinish
    PaperFinish

const FinishCount = 2

const FinishWords = ["none", "paper"]
const FinishLabels = ["None", "Paper"]

fn finish_named(word: str) -> PieceFinish
    for i in 0..FinishWords.len
        if FinishWords[i] == word: return i as PieceFinish
    return NoFinish
