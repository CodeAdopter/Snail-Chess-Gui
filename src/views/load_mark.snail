use engine/ui/ui_layout

const SpinTurnNs: i64 = 900000000
const SpinSweep: f32 = 1.9
const SweepNs: i64 = 1500000000

fn load_ink(page: Color, strength: f32) -> Color
    let luma = page.r * 0.2126 + page.g * 0.7152 + page.b * 0.0722
    return page.lerp(luma < 0.5 ? Color(1.0, 1.0, 1.0, 1.0) : Color(0.0, 0.0, 0.0, 1.0), strength)

fn spin_start(ui: *UiCanvas) -> f32
    if ui.still: return 0.0
    return (now_ns() % SpinTurnNs) as f32 / SpinTurnNs as f32 * 6.2831855

fn load_spinner(ui: *UiCanvas, cx: f32, cy: f32, size: f32, ink: Color)
    let w = max(size * 0.09, 2.0)
    let r = size * 0.5 - w * 0.5
    ui.ring(cx, cy, r, w, ink.with_alpha(ink.a * 0.2))
    ui.ring(cx, cy, r, w, ink, spin_start(ui), SpinSweep, true)
    if not ui.still: ui.wake_in(0.0)

fn load_card(ui: *UiCanvas, key: int, wide: f32, tall: f32, fill: Color, radius: f32, spin: *UiPath)
    let ink = load_ink(fill, 0.5)
    with ui.open(UiNode(name: "loadcard", key: key, width: UiSize.fixed(wide), height: UiSize.fixed(tall), clip: true, align: Vec2(0.5, 0.5), box: UiBox(fill: UiFill.solid(fill), radius: Vec4.splat(radius))))
        if not ui.still
            let half = wide * 0.3
            let t = (now_ns() % SweepNs) as f32 / SweepNs as f32
            let x = -half * 2.0 + (wide + half * 2.0) * t
            let glow = load_ink(fill, 0.08)
            let clear = glow.with_alpha(0.0)
            ui.open(UiNode(name: "loadsweep", floating: true, offset: Vec2(x, 0.0), width: UiSize.fixed(half), height: UiSize.fixed(tall), box: UiBox(fill: UiFill.linear(clear, glow, 90.0))))
            ui.close()
            ui.open(UiNode(name: "loadsweep", key: 1, floating: true, offset: Vec2(x + half, 0.0), width: UiSize.fixed(half), height: UiSize.fixed(tall), box: UiBox(fill: UiFill.linear(glow, clear, 90.0))))
            ui.close()
            ui.wake_in(0.0)
        ui.drawing(spin, 24.0, 2.2, 22.0, ink)

fn turn_spin(ui: *UiCanvas, spin: *UiPath)
    let a = spin_start(ui)
    spin.clear()
    spin.move_to(12.0 + 9.0 * sin(a), 12.0 - 9.0 * cos(a))
    spin.arc(12.0, 12.0, 9.0, a, SpinSweep)
