use engine/ui/ui_layout
use src/theme/theme
use src/theme/fonts
use src/rules/primitives

const PlayerBarHeight: f32 = 36.0
const ClockWidth: f32 = 96.0

fn draw_player_bar(ui: *UiCanvas, theme: *GuiTheme, fonts: *GuiFonts, name_id: str, x: f32, y: f32, w: f32, side: Side, name: str, note: str, eval: str, clock: str, running: bool)
    if w < 1.0: return
    let disc = side == White ? Color(0.95, 0.95, 0.93, 1.0) : Color(0.08, 0.08, 0.09, 1.0)
    with ui.open(UiNode(name: name_id, floating: true, offset: Vec2(x, y), width: UiSize.fixed(w), height: UiSize.fixed(PlayerBarHeight), flow: FlowRow, gap: 10.0, align: Vec2(0.0, 0.5), padding: Vec4(12.0, 0.0, 4.0, 0.0), clip: true, box: theme.wear(UiBox(fill: UiFill.solid(theme.surface), radius: Vec4.splat(8.0), border: 1.0, border_color: theme.line))))
        ui.leaf(UiNode(width: UiSize.fixed(12.0), height: UiSize.fixed(12.0), box: UiBox(fill: UiFill.solid(disc), radius: Vec4.splat(6.0), border: 1.0, border_color: theme.muted)))
        ui.label(name, UiTextStyle(face: fonts.strong, size: 13.0, color: theme.ink))
        if note.len > 0: ui.label(note, UiTextStyle(face: fonts.text, size: 12.0, color: theme.muted))
        ui.spacer()
        if eval.len > 0: ui.label(eval, UiTextStyle(face: fonts.strong, size: 12.5, color: theme.ink))
        if clock.len > 0
            with ui.open(UiNode(width: UiSize.fixed(ClockWidth), height: UiSize.fixed(PlayerBarHeight - 8.0), align: Vec2(0.5, 0.5), box: UiBox(fill: UiFill.solid(running ? theme.accent : theme.sunken), radius: Vec4.splat(6.0))))
                ui.label(clock, UiTextStyle(face: fonts.mono, size: 15.0, color: running ? theme.accent_ink : theme.ink))
