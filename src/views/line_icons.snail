const LineIconCount = LineIconPaths.len

struct LineIcons
    paths: [LineIconCount]UiPath
    made: bool

    fn make()
        if made: return
        for i in 0..LineIconCount
            let p = &paths[i]
            p.tolerance = 0.04
            if i == IconGear as int: gear_path(p)
            else: p.svg(LineIconPaths[i])
        made = true

    fn show(ui: *UiCanvas, icon: LineIcon, size: f32, color: Color, node: UiNode = UiNode())
        make()
        ui.drawing(&paths[icon as int], LineIconBox, LineIconWeight, size, color, node)

    fn path(icon: LineIcon) -> *UiPath
        make()
        return &paths[icon as int]

    fn release()
        for i in 0..LineIconCount
            paths[i].free_all()

fn gear_path(p: *UiPath)
    let teeth = 8
    let outer: f32 = 10.0
    let inner: f32 = 7.4
    let step = 6.2831855 / teeth as f32
    for k in 0..teeth
        let a = k as f32 * step
        let corners = [Vec2(a - step * 0.3, inner), Vec2(a - step * 0.16, outer), Vec2(a + step * 0.16, outer), Vec2(a + step * 0.3, inner)]
        for j, c in corners
            let x = 12.0 + cos(c.x) * c.y
            let y = 12.0 + sin(c.x) * c.y
            if k == 0 and j == 0: p.move_to(x, y)
            else: p.line_to(x, y)
    p.close()
    p.circle(12.0, 12.0, 3.0)
