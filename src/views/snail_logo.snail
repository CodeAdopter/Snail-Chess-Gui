use engine/ui/ui_svg
use engine/desktop/tab_strip

const SnailLogoPath = "M11.3 12.97 C11.3 11.57 12.6 10.77 13.7 11.37 C15.3 12.17 15.3 14.67 13.7 15.87 C11.6 17.37 8.5 16.47 7.6 13.97 C6.5 10.87 8.7 7.67 12 7.27 C16.1 6.77 19.4 10.17 19.2 14.17 C19 18.77 14.8 22.07 10.2 21.57 C5.1 21.07 1.3 17.07 1.3 12.27 C1.3 6.57 5.9 1.97 11.6 1.97 C17.5 1.97 22.3 6.87 22.3 12.87"
const SnailLogoBox: f32 = 23.6
const SnailLogoWeight: f32 = 2.6

struct SnailLogo
    path: UiPath
    made: bool

    fn for_strip(color: Color) -> StripLogo
        if not made
            path.tolerance = 0.04
            path.svg(SnailLogoPath)
            made = true
        return StripLogo(&path, SnailLogoBox, SnailLogoWeight, color)

    fn release()
        path.free_all()
