use engine/ui/ui_canvas

enum ThemeName: u8
    Porcelain
    AfterHours
    Charcoal
    Paper

const BasicThemes = 3
const ThemeCount = 4

enum AccentName: u8
    DeepTeal
    HarbourBlue
    Mulberry
    WarmCopper
    SnailGreen
    Graphite
    Saffron
    Rosewood

const AccentLabels = ["Deep teal", "Harbour blue", "Mulberry", "Warm copper", "Snail green", "Graphite", "Saffron", "Rosewood"]

const PageCurve: f32 = 14.0

fn theme_label(name: ThemeName) -> str
    match name
        AfterHours: return "After hours"
        Charcoal: return "Charcoal"
        Paper: return "Paper"
    return "Porcelain"

struct GuiTheme
    name: ThemeName
    page: Color
    band: Color
    surface: Color
    sunken: Color
    line: Color
    ink: Color
    muted: Color
    accent: Color
    accent_soft: Color
    accent_ink: Color
    dark: bool
    warn: Color
    material: u32
    motion: Vec4
    pressed_at: f32 = -100.0
    pressed_point: f32

    static fn of(name: ThemeName) -> GuiTheme
        match name
            AfterHours: return GuiTheme(name, Color.hex(0x19231F), Color.hex(0x141C19), Color.hex(0x202D27), Color.hex(0x1C2822), Color.hex(0x36453B), Color.hex(0xE0E8DF), Color.hex(0x9DAD9F), Color.hex(0x5FA8A0), Color.hex(0x2B3D32), Color.hex(0x10201C), true, Color.hex(0xE0A35A))
            Charcoal: return GuiTheme(name, Color.hex(0x18191B), Color.hex(0x131415), Color.hex(0x222326), Color.hex(0x1D1E21), Color.hex(0x3A3C42), Color.hex(0xE6E7E9), Color.hex(0xA4A6AD), Color.hex(0x6FB3AD), Color.hex(0x303136), Color.hex(0x121314), true, Color.hex(0xE0A35A))
            Paper: return GuiTheme(name, Color.hex(0xEEE7D8), Color.hex(0xE2D9C6), Color.hex(0xF8F3E8), Color.hex(0xE9E1D0), Color.hex(0xD2C7B2), Color.hex(0x24211D), Color.hex(0x736B5E), Color.hex(0xB23A2C), Color.hex(0xF4E2D9), Color.hex(0xFFF9F0), false, Color.hex(0xB45A2D))
        return GuiTheme(name, Color.hex(0xF7F8F5), Color.hex(0xE9ECE6), Color.hex(0xFFFFFF), Color.hex(0xF1F3EE), Color.hex(0xE2E7E3), Color.hex(0x1C2C32), Color.hex(0x84908F), Color.hex(0x286A67), Color.hex(0xEDF5F1), Color.hex(0xFFFFFF), false, Color.hex(0xB45A2D))

    fn with_accent(a: AccentName) -> GuiTheme
        var t = *self
        if a == DeepTeal: return t
        if dark
            match a
                HarbourBlue: t.accent = Color.hex(0x95B8DC)
                Mulberry: t.accent = Color.hex(0xC4A1C7)
                WarmCopper: t.accent = Color.hex(0xD1AA82)
                SnailGreen: t.accent = Color.hex(0x62C69B)
                Graphite: t.accent = Color.hex(0xB3B9C4)
                Saffron: t.accent = Color.hex(0xD9BC62)
                Rosewood: t.accent = Color.hex(0xD9949F)
            return t
        match a
            HarbourBlue
                t.accent = Color.hex(0x3D658C)
                t.accent_soft = Color.hex(0xEBF0F6)
            Mulberry
                t.accent = Color.hex(0x826085)
                t.accent_soft = Color.hex(0xF3EDF3)
            WarmCopper
                t.accent = Color.hex(0x9A6944)
                t.accent_soft = Color.hex(0xF6EFE8)
            SnailGreen
                t.accent = Color.hex(0x1C6F52)
                t.accent_soft = Color.hex(0xE9F3EE)
            Graphite
                t.accent = Color.hex(0x596170)
                t.accent_soft = Color.hex(0xEFF1F3)
            Saffron
                t.accent = Color.hex(0x8C6A14)
                t.accent_soft = Color.hex(0xF7F1E1)
            Rosewood
                t.accent = Color.hex(0xA2475A)
                t.accent_soft = Color.hex(0xF7ECEE)
        return t

    fn detailed() -> bool
        return name as int >= BasicThemes

    fn wear(b: UiBox, spills: bool = true) -> UiBox
        if material == 0: return b
        var w = b
        w.material = material
        w.values = motion
        if spills: w.reach = spill()
        return w

    fn spill() -> f32
        return name == Paper ? PaperSpill : 0.0

    fn feel(ui: *UiCanvas)
        if ui.still
            motion = Vec4(-1.0e9, -1.0e5, -1.0e5, 0.0)
            return
        let p = ui.pointer
        if ui.pointer_pressed
            pressed_at = ui.time
            pressed_point = clamp(floor(p.x * 0.5 + 0.5), 0.0, 4095.0) * 4096.0 + clamp(floor(p.y * 0.5 + 0.5), 0.0, 4095.0)
        motion = Vec4(ui.time - pressed_at, p.x, p.y, pressed_point)

    fn gain() -> Color
        return dark ? Color.hex(0x6CC48C) : Color.hex(0x2E8A4F)

    fn loss() -> Color
        return dark ? Color.hex(0xE8776E) : Color.hex(0xC4433A)

    fn widgets(face: int, bold: int) -> UiTheme
        return UiTheme(face, bold, 13.0, ink, muted, page, surface, surface, sunken, line, accent, accent_ink, accent, 6.0)

const PaperSpill: f32 = 10.0
