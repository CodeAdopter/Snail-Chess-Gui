use src/database/eval_recorder
use src/game/pgn_read

fn db_fast_evals(rec: *EvalRecorder, text: str, most: int, names: str) -> (int, int)
    if not rec or not rec.open: return 0, 0
    var begins: [..]int
    defer begins.free()
    scan_pgn(text, &begins, most + 1)
    var kept = 0
    let read = min(begins.len as int, most)
    let reach = begins.len as int > most ? begins[most] : text.len as int
    for g in 0..read
        let s = begins[g]
        var lex = PgnLexer(text: text, at: s)
        var white = ""
        var black = ""
        var fen = ""
        var t = lex.next()
        while t == PgnTag
            if lex.tag_name == "White": white = lex.token
            elif lex.tag_name == "Black": black = lex.token
            elif lex.tag_name == "FEN": fen = lex.token
            t = lex.next()
        var b: Board
        if fen.len == 0 or not b.load_fen(fen): b.load_fen(StartFen)
        var before = b
        var played = NoMove
        var depth = 0
        loop
            if t == PgnEnd or t == PgnResult or t == PgnTag: break
            if t == PgnOpen: depth += 1
            elif t == PgnClose: depth -= 1
            elif t == PgnSymbol and depth == 0
                let (m, ok) = parse_move(&b, lex.token)
                if not ok: break
                before = b
                played = m
                b.play(m)
            elif t == PgnComment and depth == 0 and played != NoMove
                let (kind, score, reached, ok) = db_fast_score(lex.token)
                if ok
                    var line: [1]Move
                    line[0] = played
                    rec.keep(&before, db_uci_name(names, before.side == White ? white : black), 1, reached, 0, kind, score, 0, 0, line[0..1], false)
                    kept += 1
                played = NoMove
            t = lex.next()
    return kept, reach

fn db_uci_name(names: str, label: str) -> str
    var from = 0
    for i in 0..names.len + 1
        if i < names.len and names[i] != '\n': continue
        let line = names[from..i]
        from = i as int + 1
        if line.len > label.len and line[label.len] == '\t' and line[0..label.len] == label: return line[label.len + 1..line.len]
    return label

fn db_fast_score(comment: str) -> (ScoreKind, int, int, bool)
    var i = 0
    while i < comment.len and comment[i] == ' '
        i += 1
    var sign = 1
    if i < comment.len and (comment[i] == '+' or comment[i] == '-')
        if comment[i] == '-': sign = -1
        i += 1
    let mate = i < comment.len and (comment[i] == 'M' or comment[i] == '#')
    if mate: i += 1
    var whole = 0
    var cents = 0
    var places = 0
    var any = false
    while i < comment.len and comment[i] >= '0' and comment[i] <= '9'
        whole = min(whole * 10 + (comment[i] - '0') as int, 100000)
        i += 1
        any = true
    if i < comment.len and comment[i] == '.'
        i += 1
        while i < comment.len and comment[i] >= '0' and comment[i] <= '9'
            if places < 2
                cents = cents * 10 + (comment[i] - '0') as int
                places += 1
            i += 1
    if not any or i >= comment.len or comment[i] != '/': return NoScore, 0, 0, false
    i += 1
    var reached = 0
    while i < comment.len and comment[i] >= '0' and comment[i] <= '9'
        reached = min(reached * 10 + (comment[i] - '0') as int, 255)
        i += 1
    if reached == 0: return NoScore, 0, 0, false
    if mate: return MateIn, sign * max(whole, 1), reached, true
    if places == 1: cents *= 10
    return Centipawns, sign * (whole * 100 + cents), reached, true
