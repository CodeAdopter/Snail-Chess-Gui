extern include "fast_win32.h"

extern fn sn_fc_command_tail(out: *u8, size: int) -> int
extern fn sn_fc_own_path(out: *u8, size: int) -> int
extern fn sn_fc_env(name: *u8, name_len: int, out: *u8, size: int) -> int
extern fn sn_fc_start(command: *u8, command_len: int, process: **void, from_child: **void, job: **void) -> u32
extern fn sn_fc_finish(process: *void) -> int
